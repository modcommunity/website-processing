---
import { Globe, Heart, LineChart, RefreshCw, Search, Users } from 'lucide-react';
import SectionIntro from "./helper/SectionIntro.astro";
import FeatureCard from "./helper/FeatureCard.astro";
import { getT } from "../../i18n/t";
import { localizePath } from "../../i18n/config";


const t = getT(Astro.currentLocale);
---

<section class="py-20 px-4 container mx-auto flex flex-col gap-10">
    <SectionIntro eyebrow={t('landing.servers.eyebrow')}>
        <h2 slot="title" set:html={t('landing.servers.titleHtml')}></h2>
        <p set:html={t('landing.servers.introHtml')}></p>
    </SectionIntro>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3">
        <FeatureCard icon={Search} title={t('landing.servers.c1t')} class="intersect-once intersect:motion-preset-slide-up">
            <Fragment set:html={t('landing.servers.c1b')} />
        </FeatureCard>
        <FeatureCard icon={RefreshCw} title={t('landing.servers.c2t')} class="intersect-once intersect:motion-preset-slide-up">
            <Fragment set:html={t('landing.servers.c2b')} />
        </FeatureCard>
        <FeatureCard icon={LineChart} title={t('landing.servers.c3t')} class="intersect-once intersect:motion-preset-slide-up">
            <Fragment set:html={t('landing.servers.c3b')} />
        </FeatureCard>
        <FeatureCard icon={Users} title={t('landing.servers.c4t')} class="intersect-once intersect:motion-preset-slide-up">
            <Fragment set:html={t('landing.servers.c4b')} />
        </FeatureCard>
        <FeatureCard icon={Heart} title={t('landing.servers.c5t')} class="intersect-once intersect:motion-preset-slide-up">
            <Fragment set:html={t('landing.servers.c5b')} />
        </FeatureCard>
        <FeatureCard icon={Globe} title={t('landing.servers.c6t')} class="intersect-once intersect:motion-preset-slide-up">
            <Fragment set:html={t('landing.servers.c6b')} />
        </FeatureCard>
    </div>

    <div class="flex justify-center">
        <a href={localizePath("/servers", Astro.currentLocale)} class="btn btn-special">{t('landing.servers.browse')}</a>
    </div>
</section>
