---
import { BadgeCheck, CloudDownload, Hammer, MessagesSquare, MonitorSmartphone, Server, ShoppingBag, Trophy, Users, Wrench } from 'lucide-react';
import SectionIntro from "./helper/SectionIntro.astro";
import FeatureCard from "./helper/FeatureCard.astro";
import { getT } from "../../i18n/t";
import { localizePath } from "../../i18n/config";
import { GAMESPICE_URL } from "../../lib/site";

/*
 * GameSpice, the gaming platform (formerly Dot), as a grid of what it does.
 * The platform has its own site, so the main button leaves this one. Each card
 * is a feature that exists; see the note at the top of `platform.ts`.
 */
const t = getT(Astro.currentLocale);
const p = (k: string) => t(`landing.platform.${k}`);

const features = [
    { icon: MonitorSmartphone, n: 1 },
    { icon: Server, n: 2 },
    { icon: CloudDownload, n: 3 },
    { icon: Users, n: 4 },
    { icon: Trophy, n: 5 },
    { icon: ShoppingBag, n: 6 },
    { icon: Hammer, n: 7 },
    { icon: Wrench, n: 8 },
    { icon: MessagesSquare, n: 9 },
];
---

<section data-section="platform" id="gaming-platform" class="scroll-mt-20 py-20 px-4 container mx-auto flex flex-col gap-10">
    <SectionIntro eyebrow={p('eyebrow')}>
        <div slot="title" class="flex items-center gap-3">
            <img src="/images/gamespice-mark.svg" alt="" width="48" height="48" class="h-12 w-12 shrink-0" />
            <h2 class="min-w-0" set:html={p('titleHtml')}></h2>
        </div>
        <p set:html={p('introHtml')}></p>
    </SectionIntro>

    <div class="flex justify-center">
        <span class="inline-flex items-center gap-2 rounded-full border border-accent/30 bg-accent/10 px-3 py-1 text-xs font-semibold text-accent">
            <BadgeCheck className="h-4 w-4" />
            {p('badge')}
        </span>
    </div>

    <div class="@container min-w-0">
        <ul aria-label={p('featuresLabel')} class="grid grid-cols-1 gap-4 @2xl:grid-cols-2 @5xl:grid-cols-3">
            {features.map(({ icon, n }) => (
                <li class="min-w-0 intersect-once intersect:motion-preset-slide-up">
                    <FeatureCard icon={icon} title={p(`f${n}t`)} class="h-full">
                        {p(`f${n}b`)}
                    </FeatureCard>
                </li>
            ))}
        </ul>
    </div>

    <div class="flex flex-wrap justify-center gap-3">
        <a
            href={GAMESPICE_URL}
            target="_blank"
            rel="noopener"
            data-umami-event="cta_gamespice"
            data-umami-event-place="platform"
            class="btn btn-special inline-flex items-center gap-2"
        >
            <img src="/images/gamespice-mark.svg" alt="" width="20" height="20" class="h-5 w-5" />
            {p('button')}
        </a>
        <a href={localizePath("/roadmap", Astro.currentLocale)} class="btn btn-primary">{p('buttonRoadmap')}</a>
    </div>
</section>
