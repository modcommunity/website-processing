---
import { BadgeCheck } from 'lucide-react';
import SectionIntro from "./helper/SectionIntro.astro";
import StackDiagram from "../platform/StackDiagram";
import { stackLayers } from "../platform/layers";
import { getT } from "../../i18n/t";
import { localizePath } from "../../i18n/config";

const t = getT(Astro.currentLocale);
const layers = stackLayers(t);
---

<section data-section="platform" id="gaming-platform" class="scroll-mt-20 py-20 px-4 container mx-auto flex flex-col gap-10">
    <SectionIntro eyebrow={t('landing.platform.eyebrow')}>
        <h2 slot="title" set:html={t('landing.platform.titleHtml')}></h2>
        <p set:html={t('landing.platform.introHtml')}></p>
    </SectionIntro>

    <div class="flex justify-center">
        <span class="inline-flex items-center gap-2 rounded-full border border-accent/30 bg-accent/10 px-3 py-1 text-xs font-semibold text-accent">
            <BadgeCheck className="h-4 w-4" />
            {t('landing.platform.badge')}
        </span>
    </div>

    <div class="mx-auto w-full max-w-4xl intersect-once intersect:motion-preset-slide-up">
        <StackDiagram client:visible compact layers={layers} hint={t('landing.platformPage.stackHint')} label={t('landing.platformPage.stackLabel')} />
    </div>

    <div class="flex flex-wrap justify-center gap-3">
        <a href={localizePath("/platform", Astro.currentLocale)} class="btn btn-special">{t('landing.platform.button')}</a>
        <a href={localizePath("/roadmap", Astro.currentLocale)} class="btn btn-primary">{t('landing.platform.buttonRoadmap')}</a>
    </div>
</section>
