---
import {
    FaCubes,
    FaHammer,
    FaServer,
    FaUsers,
    FaLayerGroup,
} from "react-icons/fa6";

const pillars = [
    { icon: FaCubes, title: "Assets", href: "/assets", desc: "Game assets & tools" },
    { icon: FaHammer, title: "Mods", href: "/mods", desc: "A full mod workshop" },
    { icon: FaServer, title: "Servers", href: "/servers", desc: "Live server browser" },
    { icon: FaUsers, title: "Communities", href: "/communities", desc: "Multi-game hubs" },
    { icon: FaLayerGroup, title: "Collections", href: "/collections", desc: "Curated lists" },
];
---

<section class="px-4 pb-6 container mx-auto">
    <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-5">
        {pillars.map((p) => (
            <a
                href={p.href}
                class="card group items-center text-center hover:!border-accent"
            >
                <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-accent/10 text-accent ring-1 ring-accent/20 transition-transform duration-200 group-hover:scale-110">
                    <p.icon className="h-6 w-6" />
                </span>
                <span class="font-pjs font-bold text-foreground">{p.title}</span>
                <span class="text-xs text-muted">{p.desc}</span>
            </a>
        ))}
    </div>
</section>
