---
import { Code2, History, Key, PackageOpen, TerminalSquare } from 'lucide-react';
import SectionIntro from "./helper/SectionIntro.astro";
import FeatureCard from "./helper/FeatureCard.astro";
import { getT } from "../../i18n/t";
import { localizePath } from "../../i18n/config";


const t = getT(Astro.currentLocale);
---

<section class="py-20 px-4 container mx-auto flex flex-col gap-10">
    <SectionIntro eyebrow={t('landing.api.eyebrow')}>
        <h2 slot="title" set:html={t('landing.api.titleHtml')}></h2>
        <p set:html={t('landing.api.introHtml')}></p>
    </SectionIntro>

    <div class="grid grid-cols-1 gap-8 @5xl:grid-cols-2">
        {/* Own container — see Feedback.astro: half-width cards must be laid
            out against the half, not against the page. */}
        <div class="@container">
            <div class="grid grid-cols-1 gap-6 @2xl:grid-cols-2">
                <FeatureCard icon={Key} title={t('landing.api.c1t')} class="intersect-once intersect:motion-preset-slide-up">
                    <Fragment set:html={t('landing.api.c1b')} />
                </FeatureCard>
                <FeatureCard icon={Code2} title={t('landing.api.c2t')} class="intersect-once intersect:motion-preset-slide-up motion-delay-80">
                    <Fragment set:html={t('landing.api.c2b')} />
                </FeatureCard>
                <FeatureCard icon={PackageOpen} title={t('landing.api.c3t')} class="intersect-once intersect:motion-preset-slide-up">
                    <Fragment set:html={t('landing.api.c3b')} />
                </FeatureCard>
                <FeatureCard icon={History} title={t('landing.api.c4t')} class="intersect-once intersect:motion-preset-slide-up motion-delay-80">
                    <Fragment set:html={t('landing.api.c4b')} />
                </FeatureCard>
            </div>
        </div>

        {/*
          * Terminal snippet. `min-w-0` is load-bearing: a grid item's automatic
          * minimum size is its content's, and the <pre> below is one long
          * unbreakable curl line — without it the column grows to ~440px and
          * drags a horizontal scrollbar onto the whole page on a phone. With
          * it, the `overflow-x-auto` on the <pre> does its job and the snippet
          * scrolls by itself.
          */}
        <div class="min-w-0 overflow-hidden rounded-xl border border-border bg-background/70 intersect-once intersect:motion-preset-slide-left">
            <div class="flex items-center gap-2 border-b border-border px-4 py-2.5">
                <span class="h-3 w-3 rounded-full bg-danger/70"></span>
                <span class="h-3 w-3 rounded-full bg-warning/70"></span>
                <span class="h-3 w-3 rounded-full bg-success/70"></span>
                <span class="ml-2 text-xs text-muted">release.sh</span>
            </div>
            {/*
              * A real release pipeline, in the shape a CI job would actually
              * run it: shebang, variables at the top, ids captured from the
              * responses rather than pasted in.
              *
              * The endpoints are taken from website-city's
              * `docs/api/public-content-api.md`, not invented:
              *   - POST /api/content/{type}        creates one — the COLLECTION
              *     url, no id, because the id is what it hands back.
              *     /api/content/mod/{id} is the read/update/delete form.
              *   - POST /api/content/file?name=…   raw-bytes upload; this form
              *     answers with a single object (multipart answers an array).
              *   - PUT  /api/content/{type}/{id}/releases   cuts the release
              *     and attaches the file ids.
              * Success wraps its payload in `data`, hence the `.data.id`.
              */}
            <pre class="overflow-x-auto p-4 text-[12.5px] leading-relaxed font-mono text-foreground/90"><code><span class="text-accent">#!/usr/bin/env bash</span>
<span class="text-muted"># Build → publish, on every commit.</span>
<span class="text-warning">set</span> -euo pipefail

API=<span class="text-success-2">"https://api.moddingcommunity.com/api/content"</span>
TOKEN=<span class="text-success-2">"$&lbrace;TMC_TOKEN&rbrace;"</span>  <span class="text-muted"># tmc_… bearer, or a signed Ed25519 JWT</span>
APP_ID=<span class="text-success-2">42</span>
VERSION=<span class="text-success-2">"1.2.0"</span>
ARCHIVE=<span class="text-success-2">"dist/MyMod-$VERSION.zip"</span>

<span class="text-muted"># 1. Create the mod (or asset, community, collection…).</span>
MOD_ID=$(<span class="text-accent">curl</span> -sX POST <span class="text-success-2">"$API/mod"</span> \
  -H <span class="text-success-2">"Authorization: Bearer $TOKEN"</span> \
  -H <span class="text-success-2">"Content-Type: application/json"</span> \
  -d <span class="text-success-2">"&lbrace;\"name\":\"My Mod\",\"appId\":$APP_ID&rbrace;"</span> | <span class="text-accent">jq</span> -r .data.id)

<span class="text-muted"># 2. Upload the archive.</span>
FILE_ID=$(<span class="text-accent">curl</span> -sX POST <span class="text-success-2">"$API/file?name=$(basename "$ARCHIVE")"</span> \
  -H <span class="text-success-2">"Authorization: Bearer $TOKEN"</span> \
  -H <span class="text-success-2">"Content-Type: application/zip"</span> \
  --data-binary <span class="text-success-2">"@$ARCHIVE"</span> | <span class="text-accent">jq</span> -r .data.id)

<span class="text-muted"># 3. Cut the release, pointing at it.</span>
<span class="text-accent">curl</span> -X PUT <span class="text-success-2">"$API/mod/$MOD_ID/releases"</span> \
  -H <span class="text-success-2">"Authorization: Bearer $TOKEN"</span> \
  -H <span class="text-success-2">"Content-Type: application/json"</span> \
  -d <span class="text-success-2">"[&lbrace;\"version\":\"$VERSION\",\"files\":[\"$FILE_ID\"]&rbrace;]"</span></code></pre>
        </div>
    </div>

    {/* Everything above is reachable with curl; the CLI is the version of it
        that already knows the ordering, the caps and the retries. */}
    <div class="flex justify-center">
        <a href={localizePath("/tmc-cli", Astro.currentLocale)} class="btn btn-special">
            <TerminalSquare className="h-5 w-5" />
            <span>{t('landing.api.cliButton')}</span>
        </a>
    </div>
</section>
