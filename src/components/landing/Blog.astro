---
import Articles from "./blog/Articles"
import SectionIntro from "./helper/SectionIntro.astro"
import { getT } from "../../i18n/t";

const t = getT(Astro.currentLocale);
---

<section class="px-4 py-20 container mx-auto flex flex-col gap-10">
    <SectionIntro eyebrow={t('landing.blog.eyebrow')}>
        <h2 slot="title" set:html={t('landing.blog.titleHtml')}></h2>
        <p set:html={t('landing.blog.introHtml')}></p>
    </SectionIntro>
    <Articles
        client:load
        moddingGuidesHtml={t('landing.blog.moddingGuidesHtml')}
        serverGuidesHtml={t('landing.blog.serverGuidesHtml')}
        prevLabel={t('landing.blog.prev')}
        nextLabel={t('landing.blog.next')}
    />
</section>
