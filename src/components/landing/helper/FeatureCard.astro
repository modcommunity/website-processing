---
import type { IconLike } from "@modcommunity/shared"

type Props = {
    icon: IconLike
    title: string
    /** Optional accent tag shown in the top-right (e.g. "Planned", "API"). */
    tag?: string
    class?: string
}

const { icon: Icon, title, tag, class: className } = Astro.props as Props
---

<div class={`card group ${className ?? ""}`}>
    <div class="flex items-start gap-4">
        <span
            class="flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-accent/10 text-accent ring-1 ring-accent/20 transition-colors group-hover:bg-accent/15"
        >
            <Icon className="h-5 w-5" />
        </span>
        <div class="flex flex-col gap-1 grow">
            <div class="flex items-center justify-between gap-2">
                <h4 class="text-base">{title}</h4>
                {tag && (
                    <span
                        class="shrink-0 rounded-full border border-accent/30 bg-accent/10 px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-accent"
                    >
                        {tag}
                    </span>
                )}
            </div>
            <div class="text-sm text-muted [&_a]:text-accent [&_.special]:text-accent">
                <slot />
            </div>
        </div>
    </div>
</div>
