---
/**
 * Decorative area/line trend chart for the stats section (e.g. players or
 * downloads over time). Single accent hue, thin 2px line, soft gradient fill,
 * recessive gridlines and a single labelled end marker — no per-point numbers.
 */
type Props = {
    /** Series values (0-100), left→right over time. */
    data?: number[]
    label?: string
    value?: string
    class?: string
    /** Unique id so multiple charts don't share gradient defs. */
    id?: string
}

const {
    data = [26, 34, 30, 46, 42, 58, 54, 70, 66, 82, 88],
    label,
    value,
    class: className,
    id = "area",
} = Astro.props as Props

const W = 320
const H = 150
const padL = 10
const padR = 10
const padT = 16
const padB = 24
const plotW = W - padL - padR
const plotH = H - padT - padB
const baseline = padT + plotH

const pts = data.map((v, i) => [
    padL + (i * plotW) / (data.length - 1),
    padT + (1 - v / 100) * plotH,
])

// Smooth cubic path with horizontal tangents at each vertex.
const linePath = pts
    .map((p, i, a) => {
        if (i === 0) return `M ${p[0].toFixed(1)},${p[1].toFixed(1)}`
        const prev = a[i - 1]
        const cx = ((prev[0] + p[0]) / 2).toFixed(1)
        return `C ${cx},${prev[1].toFixed(1)} ${cx},${p[1].toFixed(1)} ${p[0].toFixed(1)},${p[1].toFixed(1)}`
    })
    .join(" ")

const areaPath = `${linePath} L ${pts[pts.length - 1][0].toFixed(1)},${baseline} L ${pts[0][0].toFixed(1)},${baseline} Z`
const end = pts[pts.length - 1]
const grid = [0.25, 0.5, 0.75].map((f) => padT + f * plotH)
---

<div class={`flex flex-col gap-3 ${className ?? ""}`}>
    {(label || value) && (
        <div class="flex items-baseline justify-between gap-2">
            {label && <span class="text-sm text-muted">{label}</span>}
            {value && <span class="text-sm font-semibold text-foreground">{value}</span>}
        </div>
    )}
    <svg viewBox={`0 0 ${W} ${H}`} class="w-full" role="img" aria-label={label}>
        <defs>
            <linearGradient id={`${id}-fill`} x1="0" x2="0" y1="0" y2="1">
                <stop offset="0%" stop-color="var(--color-accent)" stop-opacity="0.35" />
                <stop offset="100%" stop-color="var(--color-accent)" stop-opacity="0" />
            </linearGradient>
        </defs>
        {grid.map((y) => (
            <line
                x1={padL}
                x2={W - padR}
                y1={y}
                y2={y}
                stroke="var(--color-border)"
                stroke-width="1"
                stroke-opacity="0.5"
            />
        ))}
        <path d={areaPath} fill={`url(#${id}-fill)`} />
        <path
            d={linePath}
            fill="none"
            stroke="var(--color-accent)"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
        />
        <circle cx={end[0]} cy={end[1]} r="4" fill="var(--color-accent)" />
        <circle cx={end[0]} cy={end[1]} r="7" fill="var(--color-accent)" fill-opacity="0.25" />
    </svg>
</div>
