---
import { Box, Code2, Github, Images, Star, Tags, Workflow } from 'lucide-react';
import SectionIntro from "./helper/SectionIntro.astro";
import FeatureCard from "./helper/FeatureCard.astro";
import { getT } from "../../i18n/t";
import { localizePath } from "../../i18n/config";


const t = getT(Astro.currentLocale);
---

<section class="py-20 px-4 container mx-auto flex flex-col gap-10">
    <SectionIntro eyebrow={t('landing.assets.eyebrow')}>
        <h2 slot="title" set:html={t('landing.assets.titleHtml')}></h2>
        <p set:html={t('landing.assets.introHtml')}></p>
    </SectionIntro>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-3">
        <FeatureCard icon={Tags} title={t('landing.assets.c1t')} class="intersect-once intersect:motion-preset-slide-up">
            <Fragment set:html={t('landing.assets.c1b')} />
        </FeatureCard>
        <FeatureCard icon={Images} title={t('landing.assets.c2t')} class="intersect-once intersect:motion-preset-slide-up">
            <Fragment set:html={t('landing.assets.c2b')} />
        </FeatureCard>
        <FeatureCard icon={Star} title={t('landing.assets.c3t')} class="intersect-once intersect:motion-preset-slide-up">
            <Fragment set:html={t('landing.assets.c3b')} />
        </FeatureCard>
        <FeatureCard icon={Code2} title={t('landing.assets.c4t')} class="intersect-once intersect:motion-preset-slide-up">
            <Fragment set:html={t('landing.assets.c4b')} />
        </FeatureCard>
        <FeatureCard icon={Workflow} title={t('landing.assets.c5t')} class="intersect-once intersect:motion-preset-slide-up">
            <Fragment set:html={t('landing.assets.c5b')} />
        </FeatureCard>
        <FeatureCard icon={Github} title={t('landing.assets.c6t')} class="intersect-once intersect:motion-preset-slide-up">
            <Fragment set:html={t('landing.assets.c6b')} />
        </FeatureCard>
    </div>

    {/* Open-source asset library highlight */}
    <div class="relative overflow-hidden rounded-2xl border border-accent/30 bg-gradient-to-br from-accent/10 via-surface to-surface p-6 sm:p-8">
        <span class="pointer-events-none absolute -right-8 -top-8 h-32 w-32 rounded-full bg-accent/20 blur-3xl"></span>
        <div class="flex flex-col items-start gap-4 sm:flex-row sm:items-center">
            <span class="flex h-14 w-14 shrink-0 items-center justify-center rounded-2xl bg-accent/15 text-accent ring-1 ring-accent/30">
                <Box className="h-7 w-7" />
            </span>
            <div class="flex flex-col gap-1">
                <div class="flex items-center gap-3">
                    <h3 class="text-xl" set:html={t('landing.assets.highlightTitle')}></h3>
                    <span class="rounded-full border border-accent/30 bg-accent/10 px-2.5 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-accent">{t('landing.assets.highlightBadge')}</span>
                </div>
                <p class="text-muted" set:html={t('landing.assets.highlightHtml')}></p>
            </div>
        </div>
    </div>

    <div class="flex justify-center">
        <a href={localizePath("/assets", Astro.currentLocale)} class="btn btn-special">{t('landing.assets.button')}</a>
    </div>
</section>
