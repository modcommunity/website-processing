---
import { Heart, PackageOpen, PenTool, Search } from 'lucide-react';
import SectionIntro from "./helper/SectionIntro.astro";
import FeatureCard from "./helper/FeatureCard.astro";
import { getT } from "../../i18n/t";
import { localizePath } from "../../i18n/config";


const t = getT(Astro.currentLocale);
---

<section class="py-20 px-4 container mx-auto flex flex-col gap-10">
    <SectionIntro eyebrow={t('landing.collections.eyebrow')}>
        <h2 slot="title" set:html={t('landing.collections.titleHtml')}></h2>
        <p set:html={t('landing.collections.introHtml')}></p>
    </SectionIntro>

    <div class="grid grid-cols-1 gap-6 @3xl:grid-cols-2 @5xl:grid-cols-4">
        <FeatureCard icon={PackageOpen} title={t('landing.collections.c1t')} class="intersect-once intersect:motion-preset-slide-up">
            <Fragment set:html={t('landing.collections.c1b')} />
        </FeatureCard>
        <FeatureCard icon={PenTool} title={t('landing.collections.c2t')} class="intersect-once intersect:motion-preset-slide-up">
            <Fragment set:html={t('landing.collections.c2b')} />
        </FeatureCard>
        <FeatureCard icon={Heart} title={t('landing.collections.c3t')} class="intersect-once intersect:motion-preset-slide-up">
            <Fragment set:html={t('landing.collections.c3b')} />
        </FeatureCard>
        <FeatureCard icon={Search} title={t('landing.collections.c4t')} class="intersect-once intersect:motion-preset-slide-up">
            <Fragment set:html={t('landing.collections.c4b')} />
        </FeatureCard>
    </div>

    <div class="flex justify-center">
        <a href={localizePath("/collections", Astro.currentLocale)} class="btn btn-special">{t('landing.collections.button')}</a>
    </div>
</section>
