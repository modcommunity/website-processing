---
import SectionIntro from "./helper/SectionIntro.astro";
import FeatureCard from "./helper/FeatureCard.astro";

import {
    FaBoxOpen,
    FaPenNib,
    FaHeart,
    FaMagnifyingGlass,
} from "react-icons/fa6";
---

<section class="py-20 px-4 container mx-auto flex flex-col gap-10">
    <SectionIntro eyebrow="Collections">
        <h2 slot="title">Curate The Best With <span class="special">Collections</span></h2>
        <p>
            Collections let anyone hand-pick <span class="special">assets</span>,
            <span class="special">mods</span>, <span class="special">servers</span> and
            articles, or any link on the web, into a shareable, favoritable list.
        </p>
    </SectionIntro>

    <div class="grid grid-cols-1 gap-6 md:grid-cols-2 xl:grid-cols-4">
        <FeatureCard icon={FaBoxOpen} title="Mix Anything" class="intersect-once intersect:motion-preset-slide-up">
            Add assets, mods, servers or articles, or drop in any
            <span class="special">external link</span>.
        </FeatureCard>
        <FeatureCard icon={FaPenNib} title="Curate &amp; Annotate" class="intersect-once intersect:motion-preset-slide-up">
            Give each item its own <span class="special">title</span> and
            <span class="special">description</span> to tell a story.
        </FeatureCard>
        <FeatureCard icon={FaHeart} title="Favorite &amp; Follow" class="intersect-once intersect:motion-preset-slide-up">
            Others can <span class="special">favorite</span> your collections and come
            back for updates.
        </FeatureCard>
        <FeatureCard icon={FaMagnifyingGlass} title="Searchable &amp; Tagged" class="intersect-once intersect:motion-preset-slide-up">
            <span class="special">Tag</span>, <span class="special">filter</span> and
            search every collection in a dedicated browser.
        </FeatureCard>
    </div>

    <div class="flex justify-center">
        <a href="/collections" class="btn btn-special">Explore Collections</a>
    </div>
</section>
