---
import { Mail, MessagesSquare, Share2 } from 'lucide-react';
/*
 * Brand marks come from react-icons, which is the exception this repo already
 * made for Discord: lucide dropped its brand glyphs. Github / Twitter /
 * Facebook lingered as deprecated aliases (13 ts(6385) hints across this repo)
 * and are removed upstream in ~0.475, so they were a build break waiting for a
 * bump. FaSteam also retires the hand-inlined Steam path below — lucide never
 * had a Steam glyph, which is why it was inlined in the first place.
 *
 * The shared <Footer/> made the same swap in @modcommunity/shared 4.2.3, so the
 * two social rows still render the same glyphs.
 */
import { FaDiscord, FaFacebookF, FaGithub, FaSteam, FaXTwitter } from 'react-icons/fa6';
import SectionIntro from "./helper/SectionIntro.astro";
import { getT } from "../../i18n/t";
import { localizePath } from "../../i18n/config";

const t = getT(Astro.currentLocale);

/*
 * Same accounts, in the same order, as the shared <Footer/>'s social row — that
 * component is the source of truth for where TMC lives off-site, so if one is
 * added there it belongs here too. Discord leads because it is the community's
 * actual home; the footer omits it only because it already links it elsewhere.
 */
const socials = [
    { label: 'Discord', href: 'https://discord.moddingcommunity.com', icon: FaDiscord },
    { label: 'X (Twitter)', href: 'https://x.com/modcommunity_', icon: FaXTwitter },
    { label: 'GitHub', href: 'https://github.com/modcommunity', icon: FaGithub },
    { label: 'Steam', href: 'https://steamcommunity.com/groups/moddingcommunity', icon: FaSteam },
    { label: 'Facebook', href: 'https://facebook.com/tmcmods', icon: FaFacebookF },
];

/*
 * Every way in is one card, and every card is the same card: icon tile, title,
 * body, action pinned to the bottom. Before this the section was a 120-wide
 * Discord panel with a screenshot, a two-up row of small cards under it and a
 * centred contact trailer — three different sizes for four things that are all
 * just "somewhere you can talk to us". Grid items stretch, so `grow` on the
 * spacer is what actually lines the four footers up.
 */
const iconTile = "flex h-11 w-11 shrink-0 items-center justify-center rounded-xl bg-accent/10 text-accent ring-1 ring-accent/20 transition-colors group-hover:bg-accent/15";
const body = "text-sm text-muted [&_a]:text-accent [&_.special]:text-accent";
---

<section class="px-4 py-20 container mx-auto flex flex-col gap-10">
    <SectionIntro eyebrow={t('landing.joinCommunity.eyebrow')}>
        <h2 slot="title" set:html={t('landing.joinCommunity.titleHtml')}></h2>
        <p>{t('landing.joinCommunity.intro')}</p>
    </SectionIntro>

    <div class="grid grid-cols-1 gap-6 @3xl:grid-cols-2 @5xl:grid-cols-4">
        {/* Discord — the community's actual home, so it leads. */}
        <div class="card group intersect-once intersect:motion-preset-slide-right">
            <div class="flex items-start gap-4">
                <span class={iconTile}><FaDiscord className="h-5 w-5" /></span>
                <h4 class="text-base grow">{t('landing.joinCommunity.discordTitle')}</h4>
            </div>
            <p class={body} set:html={t('landing.joinCommunity.discordBlurb')}></p>
            <div class="grow"></div>
            <a href="https://discord.moddingcommunity.com" class="btn btn-special text-sm">
                <FaDiscord className="h-4 w-4" />
                {t('landing.joinCommunity.discordButton')}
            </a>
        </div>

        {/* Social accounts */}
        <div class="card group intersect-once intersect:motion-preset-slide-up motion-delay-80">
            <div class="flex items-start gap-4">
                <span class={iconTile}><Share2 className="h-5 w-5" /></span>
                <h4 class="text-base grow">{t('landing.joinCommunity.followTitle')}</h4>
            </div>
            <p class={body}>{t('landing.joinCommunity.followBlurb')}</p>
            <div class="grow"></div>
            <div class="flex flex-wrap gap-2">
                {socials.map(({ label, href, icon: Icon }) => (
                    <a
                        href={href}
                        target="_blank"
                        rel="noreferrer"
                        aria-label={label}
                        title={label}
                        class="flex h-11 w-11 items-center justify-center rounded-xl border border-border bg-surface-secondary text-muted transition-colors hover:border-accent hover:text-accent"
                    >
                        <Icon className="h-5 w-5" />
                    </a>
                ))}
            </div>
        </div>

        {/* Discussions — the easiest first post to make. */}
        <div class="card group intersect-once intersect:motion-preset-slide-up motion-delay-160">
            <div class="flex items-start gap-4">
                <span class={iconTile}><MessagesSquare className="h-5 w-5" /></span>
                <h4 class="text-base grow">{t('landing.joinCommunity.discussionsTitle')}</h4>
            </div>
            <p class={body} set:html={t('landing.joinCommunity.discussionsBlurb')}></p>
            <div class="grow"></div>
            <a href={localizePath("/discussions", Astro.currentLocale)} class="btn btn-primary text-sm">
                <MessagesSquare className="h-4 w-4" />
                {t('landing.joinCommunity.discussionsButton')}
            </a>
        </div>

        {/* Direct line to the team, for anything the Discord isn't the place for. */}
        <div class="card group intersect-once intersect:motion-preset-slide-left motion-delay-240">
            <div class="flex items-start gap-4">
                <span class={iconTile}><Mail className="h-5 w-5" /></span>
                <h4 class="text-base grow">{t('landing.joinCommunity.contactTitle')}</h4>
            </div>
            <p class={body} set:html={t('landing.joinCommunity.contactBlurb')}></p>
            <div class="grow"></div>
            <a href={localizePath("/contact", Astro.currentLocale)} class="btn btn-primary text-sm">
                <Mail className="h-4 w-4" />
                {t('landing.joinCommunity.contactButton')}
            </a>
        </div>
    </div>
</section>
