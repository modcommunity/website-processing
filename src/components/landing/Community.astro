---
import { Facebook, Github, Mail, MessagesSquare, Twitter } from 'lucide-react';
import { FaDiscord } from 'react-icons/fa6';
import Card from "../helper/Card.astro";
import SectionIntro from "./helper/SectionIntro.astro";
import { getT } from "../../i18n/t";
import { localizePath } from "../../i18n/config";

const t = getT(Astro.currentLocale);

/*
 * Same accounts, in the same order, as the shared <Footer/>'s social row — that
 * component is the source of truth for where TMC lives off-site, so if one is
 * added there it belongs here too. Discord leads because it is the community's
 * actual home; the footer omits it only because it already links it elsewhere.
 */
const socials = [
    { label: 'Discord', href: 'https://discord.moddingcommunity.com', icon: FaDiscord },
    { label: 'X (Twitter)', href: 'https://x.com/modcommunity_', icon: Twitter },
    { label: 'GitHub', href: 'https://github.com/modcommunity', icon: Github },
    { label: 'Steam', href: 'https://steamcommunity.com/groups/moddingcommunity', icon: null },
    { label: 'Facebook', href: 'https://facebook.com/modcommunity', icon: Facebook },
];

// lucide has no Steam glyph, so the shared Footer inlines this path — kept
// byte-identical here rather than reaching into the package's internals.
const STEAM_PATH = "M11.98 2C6.53 2 2.06 6.2 2 11.52l5.29 2.18a2.9 2.9 0 0 1 1.63-.5l2.35-3.4v-.05a3.86 3.86 0 1 1 3.86 3.86h-.09l-3.35 2.39a2.9 2.9 0 0 1-5.76.44l-3.78-1.56A10 10 0 1 0 11.98 2Zm-3.4 15.18-1.21-.5a2.18 2.18 0 0 0 4-.24 2.18 2.18 0 0 0-2.9-2.62l1.25.52a1.6 1.6 0 1 1-1.23 2.95l-.01-.11ZM15.13 12a2.57 2.57 0 1 0 0-5.15 2.57 2.57 0 0 0 0 5.15Zm0-.8a1.77 1.77 0 1 1 0-3.54 1.77 1.77 0 0 1 0 3.55Z";
---

<section class="px-4 py-20 container mx-auto flex flex-col gap-10">
    <SectionIntro eyebrow={t('landing.joinCommunity.eyebrow')}>
        <h2 slot="title" set:html={t('landing.joinCommunity.titleHtml')}></h2>
        <p>{t('landing.joinCommunity.intro')}</p>
    </SectionIntro>
    <div class="p-6">
        <div class="flex flex-col @2xl:flex-row justify-center gap-y-10 @2xl:gap-30 *:w-full *:@2xl:max-w-120">
            <Card className="min-w-0 intersect-once intersect:sm:motion-preset-slide-up-lg">
                <div class="w-full h-48">
                    <a href="https://discord.moddingcommunity.com">
                        <img
                            src="/images/community/discord.png"
                            class="w-full h-full brightness-75 hover:brightness-100 hover:duration-300 rounded-lg object-cover object-center"
                            alt={t('landing.joinCommunity.discordAlt')}
                        />
                    </a>
                </div>
                <div class="flex justify-center">
                    <a href="https://discord.moddingcommunity.com">
                        <h3>{t('landing.joinCommunity.discordTitle')}</h3>
                    </a>
                </div>
                <div class="p-2">
                    <ul class="list-disc pl-6" set:html={t('landing.joinCommunity.discordBulletsHtml')}></ul>
                </div>
            </Card>
        </div>
    </div>

    <div class="grid grid-cols-1 gap-6 @3xl:grid-cols-2">
        {/* Social accounts */}
        <div class="card intersect-once intersect:motion-preset-slide-up">
            <div class="flex flex-col gap-1">
                <h4 class="text-base">{t('landing.joinCommunity.followTitle')}</h4>
                <p class="text-sm text-muted">{t('landing.joinCommunity.followBlurb')}</p>
            </div>
            <div class="mt-3 flex flex-wrap gap-3">
                {socials.map(({ label, href, icon: Icon }) => (
                    <a
                        href={href}
                        target="_blank"
                        rel="noreferrer"
                        aria-label={label}
                        title={label}
                        class="flex h-11 w-11 items-center justify-center rounded-xl border border-border bg-surface-secondary text-muted transition-colors hover:border-accent hover:text-accent"
                    >
                        {Icon
                            ? <Icon className="h-5 w-5" />
                            : (
                                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" class="h-5 w-5">
                                    <path d={STEAM_PATH} />
                                </svg>
                            )}
                    </a>
                ))}
            </div>
        </div>

        {/* Discussions — the easiest first post to make. */}
        <div class="card intersect-once intersect:motion-preset-slide-up">
            <div class="flex flex-col gap-1">
                <h4 class="text-base">{t('landing.joinCommunity.discussionsTitle')}</h4>
                <p class="text-sm text-muted [&_.special]:text-accent" set:html={t('landing.joinCommunity.discussionsBlurb')}></p>
            </div>
            <div class="grow"></div>
            <div class="mt-3">
                <a href={localizePath("/discussions", Astro.currentLocale)} class="btn btn-primary text-sm">
                    <MessagesSquare className="h-4 w-4" />
                    {t('landing.joinCommunity.discussionsButton')}
                </a>
            </div>
        </div>
    </div>

    {/* Direct line to the team, for anything the Discord isn't the place for. */}
    <div class="flex flex-col items-center gap-4 text-center">
        <p class="max-w-2xl text-muted [&_.special]:text-accent" set:html={t('landing.joinCommunity.contactBlurb')}></p>
        <a href={localizePath("/contact", Astro.currentLocale)} class="btn btn-special">
            <Mail className="h-4 w-4" />
            {t('landing.joinCommunity.contactButton')}
        </a>
    </div>

</section>
