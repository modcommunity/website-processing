---
import { Gamepad2, Layers, LineChart, UserPlus } from 'lucide-react';
import SectionIntro from "./helper/SectionIntro.astro";
import FeatureCard from "./helper/FeatureCard.astro";
import { getT } from "../../i18n/t";
import { localizePath } from "../../i18n/config";


const t = getT(Astro.currentLocale);
---

<section class="py-20 px-4 container mx-auto flex flex-col gap-10">
    <SectionIntro eyebrow={t('landing.communities.eyebrow')}>
        <h2 slot="title" set:html={t('landing.communities.titleHtml')}></h2>
        <p set:html={t('landing.communities.introHtml')}></p>
    </SectionIntro>

    <div class="grid grid-cols-1 gap-6 @3xl:grid-cols-2 @5xl:grid-cols-4">
        <FeatureCard icon={UserPlus} title={t('landing.communities.c1t')} class="intersect-once intersect:motion-preset-slide-right">
            <Fragment set:html={t('landing.communities.c1b')} />
        </FeatureCard>
        <FeatureCard icon={Layers} title={t('landing.communities.c2t')} class="intersect-once intersect:motion-preset-slide-up motion-delay-80">
            <Fragment set:html={t('landing.communities.c2b')} />
        </FeatureCard>
        <FeatureCard icon={Gamepad2} title={t('landing.communities.c3t')} class="intersect-once intersect:motion-preset-slide-up motion-delay-160">
            <Fragment set:html={t('landing.communities.c3b')} />
        </FeatureCard>
        <FeatureCard icon={LineChart} title={t('landing.communities.c4t')} class="intersect-once intersect:motion-preset-slide-left motion-delay-240">
            <Fragment set:html={t('landing.communities.c4b')} />
        </FeatureCard>
    </div>

    {/* Two calls, because the section's point is that you can run one of
        these yourself: browsing is the passive half, `/communities/add` (open
        to any signed-in account on website-city) is the half the copy is
        actually about. */}
    <div class="flex flex-wrap justify-center gap-3">
        <a href={localizePath("/communities/add", Astro.currentLocale)} class="btn btn-special">{t('landing.communities.buttonCreate')}</a>
        <a href={localizePath("/communities", Astro.currentLocale)} class="btn btn-primary">{t('landing.communities.button')}</a>
    </div>
</section>
