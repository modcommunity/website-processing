---
import {
    CreditCard,
    Gavel,
    History,
    Landmark,
    Lock,
    Mail,
    Plug,
    Server,
    ShieldCheck,
    UserCog,
    Users,
    FileText,
    Wrench
} from "lucide-react"

import CLink from "./helper/CLink"
import Special from "./helper/Special.astro"
import LegalPage from "./legal/LegalPage.astro"
import LegalSection from "./legal/LegalSection.astro"
import LegalBlock from "./legal/LegalBlock.astro"
import LegalCallout from "./legal/LegalCallout.astro"

const lastUpdated = "August 6, 2026"

/**
 * The US state whose law governs these terms, and whose courts hear a dispute.
 *
 * SET THIS. While it is null the "Governing Law & Disputes" section still
 * renders and still commits to US law — which is what the DMCA section below
 * already assumes — but it omits the choice-of-forum sentence, because naming
 * the wrong court is worse than naming none. Setting it to a state name (e.g.
 * "Massachusetts") is the only change needed; the copy adapts around it.
 */
const governingState: string | null = null
---

<LegalPage title="Terms of Service" eyebrow="Legal" lastUpdated={lastUpdated}>
    <Fragment slot="lede">
        <p>These are the <strong>terms of service</strong> for <Special>The Modding Community</Special> (<span class="italic">TMC</span>). They explain what you can expect from us, and what we expect from you. We have tried to keep them readable rather than impenetrable.</p>
        <p>By using our services you agree to these terms. If you do not agree with them, please do not use our services.</p>
    </Fragment>

    <LegalSection title="Who We Are" icon={Users}>
        <p>The Modding Community is a <Special>modding and game development community</Special>. We provide a place to discover, share and manage <strong>mods</strong>, <strong>assets</strong> and <strong>game servers</strong>, alongside articles, communities, collections and discussion.</p>
        <p>These terms cover our main website at moddingcommunity.com and the landing and legal pages you are reading now. Our <CLink href="https://discord.moddingcommunity.com" target="_blank">Discord server</CLink> is additionally governed by its own rules and by Discord{"'"}s terms.</p>
    </LegalSection>

    <LegalSection title="Your Account" icon={UserCog}>
        <p>Browsing our services does <Special>not</Special> require an account. You will need one to publish content or interact with the community.</p>

        <LegalBlock title="Eligibility">
            <p>You must be at least <Special>13 years old</Special> to create an account. If the laws where you live set a higher minimum age for consenting to online services, you must meet that age instead.</p>
        </LegalBlock>

        <LegalBlock title="Account Security">
            <p>You are responsible for what happens under your account. Keep your connected sign-in providers secure, do not share access, and enable <Special>two-factor authentication</Special> — it is available to every account and we strongly recommend it.</p>
            <p>API keys are <Special>credentials</Special>. Treat them like passwords: never commit them to a public repository, never paste them into a support channel, and revoke any key you believe has been exposed.</p>
            <p>If you suspect your account has been compromised, contact us immediately.</p>
        </LegalBlock>

        <LegalBlock title="One Person, One Account">
            <p>Do not create <Special>multiple accounts</Special> to inflate ratings, evade a moderation action, or otherwise misrepresent community sentiment. Do not impersonate another person, another creator, or a member of our staff.</p>
        </LegalBlock>

        <LegalBlock title="Closing Your Account">
            <p>You may delete your account at any time from the <span class="italic">Security</span> tab of your account settings. Deletion is <Special>permanent and irreversible</Special>, and removes the content you published along with it. If you want your work to remain available to the community afterwards, transfer ownership or publish it elsewhere first.</p>
        </LegalBlock>
    </LegalSection>

    <LegalSection title="Your Content" icon={FileText}>
        <p><Special>You own what you make.</Special> Uploading a mod, asset, article, comment or any other content to TMC does not transfer ownership of it to us.</p>

        <LegalBlock title="The Licence You Grant Us">
            <p>To operate the service, we need permission to actually show your work to people. By publishing content on TMC you grant us a <Special>non-exclusive</Special>, <Special>worldwide</Special>, <Special>royalty-free</Special> licence to <strong>host</strong>, <strong>store</strong>, <strong>reproduce</strong>, <strong>display</strong> and <strong>distribute</strong> that content, and to create the technical derivatives needed to serve it — thumbnails, previews, cached copies and format conversions.</p>
            <p>This licence exists <Special>solely to run the platform</Special>. We do not use it to sell your work, to sublicense it to third parties, or to claim credit for it. It ends when you remove the content, except for reasonable backup copies and for copies others have already legitimately obtained under the licence <span class="italic">you</span> chose.</p>
            <p>We may also feature your work in our own promotional material — a screenshot on the home page, a mention in a blog post, a highlight on social media — with attribution. If you would rather we did not, just tell us.</p>
        </LegalBlock>

        <LegalBlock title="The Licence You Grant Everyone Else">
            <p>Every mod and asset published on TMC carries a <Special>licence</Special> that you select. That licence — not these terms — governs what other people may do with your work. Please read our <CLink href="/licenses">licences page</CLink> before publishing; choosing one is a real decision with real consequences.</p>
        </LegalBlock>

        <LegalBlock title="You Must Have the Right to Publish It">
            <p>You are responsible for making sure you actually have the right to upload what you upload. That means, at minimum:</p>
            <ul>
                <li>You <Special>created</Special> the content, or you have <Special>permission</Special> from whoever did.</li>
                <li>Any third-party code, models, textures, sounds or fonts you included are used in accordance with <Special>their</Special> licences, and are credited as those licences require.</li>
                <li>You are not redistributing <Special>paid or proprietary game assets</Special>, ripped content, or material extracted from another game without permission.</li>
                <li>Your work complies with the <Special>terms of the game or platform</Special> it targets. Some publishers restrict what may be modded, monetised or redistributed, and those restrictions apply regardless of what we allow.</li>
            </ul>
        </LegalBlock>
    </LegalSection>

    <LegalSection title="Acceptable Use" icon={ShieldCheck}>
        <p>We want TMC to be a <Special>welcoming and inclusive</Special> place. The rules below are what that requires in practice.</p>

        <LegalBlock title="Do Not Post">
            <ul>
                <li><Special>Malware</Special> of any kind — including keyloggers, miners, remote access tools, or code that is deliberately obfuscated to hide what it does.</li>
                <li><Special>Cheats, exploits or griefing tools</Special> intended to ruin multiplayer games for other players.</li>
                <li><Special>Pirated software</Special>, cracks, licence bypasses, or links to them.</li>
                <li><Special>Illegal content</Special>, or content that sexualises minors. This results in an immediate permanent ban and, where appropriate, a report to the authorities.</li>
                <li><Special>Harassment</Special>, threats, doxxing, or hate speech targeting people on the basis of race, ethnicity, nationality, religion, disability, gender, gender identity or sexual orientation.</li>
                <li><Special>Spam</Special>, mass unsolicited advertising, referral-link farming, or engagement manipulation.</li>
                <li><Special>Someone else{"'"}s personal information</Special> shared without their consent.</li>
            </ul>
            <p>Adult or otherwise sensitive content that is <Special>legal</Special> is permitted where relevant, but must be marked <Special>NSFW</Special> so that members who have opted out do not see it.</p>
        </LegalBlock>

        <LegalBlock title="Do Not Do">
            <ul>
                <li><Special>Attack our infrastructure</Special> — denial of service, vulnerability scanning without permission, or attempting to access accounts, data or systems that are not yours.</li>
                <li><Special>Scrape or overload our services</Special>. We provide an <Special>API</Special> for programmatic access; use it, respect its rate limits, and do not attempt to bypass them by rotating keys or addresses.</li>
                <li><Special>Manipulate rankings</Special> through vote brigading, fake reviews, self-voting rings or artificially inflated download counts.</li>
                <li><Special>Misrepresent your content</Special> — misleading titles, screenshots from a different project, or descriptions that hide what the download actually contains.</li>
                <li><Special>Resell or relist</Special> our data as your own service without our written permission.</li>
            </ul>
        </LegalBlock>

        <LegalBlock title="Security Research">
            <p>We <Special>welcome</Special> responsible security research. If you find a vulnerability, report it to us privately and give us reasonable time to fix it before disclosing it. Do not access, modify or exfiltrate data belonging to other members while testing. Researchers who follow this will not face action from us.</p>
        </LegalBlock>
    </LegalSection>

    <LegalSection title="The API & Integrations" icon={Plug}>
        <p>We offer two kinds of programmatic access, and both are a <Special>privilege we can withdraw</Special>: an <Special>API key</Special>, which acts on your behalf across the site, and an <Special>integration token</Special>, which is bound to a single item you own — typically so a plugin on your own game server can report its state to us.</p>

        <LegalBlock title="Using Them Responsibly">
            <ul>
                <li>Both are <Special>credentials</Special>. Do not publish them, embed them in a client distributed to players, or share them with anyone who is not you.</li>
                <li>Respect the <Special>rate limits</Special> attached to your key or token. Do not work around them by rotating credentials, spreading calls across accounts, or changing source address.</li>
                <li>Do not use our API to build a <Special>substitute for our service</Special>, to bulk-mirror our data, or to resell it.</li>
                <li>An integration may only be created for an item you actually <Special>own or have write access to</Special>, and only for the purpose of reporting about that item.</li>
                <li>We may pin an integration to a list of <Special>source addresses</Special> and we recommend you do so — it is the cheapest protection there is against a leaked token.</li>
            </ul>
        </LegalBlock>

        <LegalBlock title="Reporting Honestly">
            <p>An integration reports facts about a live server or party that we would otherwise measure ourselves: player counts, the current map, who is connected, and how long they played. Those figures feed public rankings and the server browser, so reporting them falsely is not a technicality — it is <Special>manipulating our platform against every other server owner on it</Special>.</p>
            <p>If we determine that an integration has reported <Special>false or inflated statistics</Special>, we will revoke the token and we will <Special>penalise the item</Special> — which for a game server means being flagged, dropped out of the server list and excluded from statistics for a period we set, up to and including permanently. Repeat or deliberate falsification also puts the <Special>account</Special> behind it at risk. Every such action is appealable in the usual way.</p>
        </LegalBlock>

        <LegalBlock title="Your Responsibility for What It Reports">
            <p>Whatever your credential does, you did. If a plugin you installed reports data you did not intend to send, or a leaked token is used by somebody else, the activity is still attributed to your account until you revoke the credential. <Special>Revoke first, ask questions afterwards</Special> — revocation is instant and irreversible, and creating a replacement takes seconds.</p>
        </LegalBlock>
    </LegalSection>

    <LegalSection title="Payments, Subscriptions & Credits" icon={CreditCard}>
        <p>Most of TMC is free. Some parts are not, and this section governs those. Nothing here is required to use the platform.</p>

        <LegalCallout tone="warning" title="Subscriptions renew automatically.">
            <p>A premium or credit subscription <Special>keeps charging you</Special> at the stated interval until you cancel it. Cancelling is one click from your account and takes effect at the end of the period you have already paid for. Credits carry <Special>no cash value</Special> and cannot be redeemed for money.</p>
        </LegalCallout>

        <LegalBlock title="What You Can Buy">
            <ul>
                <li>A <Special>premium subscription</Special> — a recurring charge that grants supporter status and the benefits attached to it.</li>
                <li><Special>Credits</Special> — a virtual balance, bought outright or granted monthly by a recurring credit subscription.</li>
                <li><Special>Access to individual content items</Special>, where a creator has chosen to charge credits for one. Access may be permanent or run for a fixed period, which is stated before you buy; buying again extends the period you already have rather than replacing it.</li>
            </ul>
        </LegalBlock>

        <LegalBlock title="Billing & Renewal">
            <p>Payments are handled by <CLink href="https://stripe.com/" target="_blank">Stripe</CLink> and <CLink href="https://www.paypal.com/" target="_blank">PayPal</CLink>. We never see or store your card or bank details.</p>
            <p>Subscriptions <Special>renew automatically</Special> at the interval and price shown at checkout, until you cancel. You may cancel at any time from your account; cancelling stops the next charge and leaves your benefits running until the end of the period you have already paid for. Prices shown are exclusive of any <Special>tax</Special> your jurisdiction imposes unless stated otherwise, and the processor collects it where it is required to.</p>
            <p>If we change the price of a subscription you already hold, we will tell you <Special>before</Special> the change takes effect and give you the chance to cancel first. A failed payment may suspend the benefits until it is settled.</p>
        </LegalBlock>

        <LegalBlock title="Credits Are Not Money">
            <p>Credits are a <Special>limited, revocable licence</Special> to use a feature of this platform. They are <Special>not legal tender, not a deposit, not a stored-value instrument</Special> and carry <Special>no cash value</Special>. They cannot be redeemed for money, sold, or transferred to anyone other than by the gifting feature we provide. We do not pay interest on a balance.</p>
            <p>Credits do not expire while your account is in good standing. If your account is <Special>deleted</Special> — by you or by us for a terms violation — any remaining balance is forfeited. If we ever discontinue credits entirely, we will give reasonable notice and will not simply delete an unused balance without offering a remedy.</p>
            <p>Credits obtained through fraud, a chargeback, or exploitation of a bug may be <Special>reversed</Special>, and doing any of those deliberately is a violation of these terms.</p>
        </LegalBlock>

        <LegalBlock title="Refunds & Your Right to Cancel">
            <p>Digital purchases are delivered <Special>immediately</Special> and are, as a rule, <Special>final</Special>. We will nonetheless refund you where the law requires it, and we will normally refund you where something genuinely went wrong on our side — a duplicate charge, a purchase that did not deliver, or an item that was materially not what it claimed to be. Ask us; we are not looking for excuses to keep your money.</p>
            <p>If you are a <Special>consumer in the EU or the UK</Special>, you normally have <Special>14 days</Special> to withdraw from a distance contract for digital content. By starting the download, spending credits, or otherwise using what you bought within that period, you <Special>expressly request immediate performance and acknowledge that you lose that right of withdrawal</Special> — which is what the checkout asks you to confirm. Your statutory rights where a product is faulty are unaffected by anything in this section.</p>
            <p>Please raise a dispute with <Special>us</Special> before filing a chargeback with your bank. A chargeback filed without contacting us first may result in the purchase being reversed and the account suspended while it is investigated.</p>
        </LegalBlock>

        <LegalBlock title="If You Sell Something Here">
            <p>Charging for an item makes you responsible for it. What you deliver must match what you described, you must have the right to sell it (see <span class="italic">Your Content</span> above), and you may not charge for content whose licence — or whose underlying game's terms — forbids monetisation. We may remove a paid item that breaks any of these, and refund the people who bought it.</p>
        </LegalBlock>
    </LegalSection>

    <LegalSection title="The Server Browser" icon={Server}>
        <p>Our server browser lists game servers discovered from <Special>public sources</Special>, primarily the <CLink href="https://developer.valvesoftware.com/wiki/Master_Server_Query_Protocol" target="_blank">Valve Master Server</CLink>, along with servers added manually by members. Server information — including names, maps, player counts and in-game player names — is <Special>broadcast publicly by the servers themselves</Special> over each game{"'"}s standard query protocol.</p>
        <p>We do not operate, endorse or vet the servers we list, and we are <Special>not responsible</Special> for what happens on them. Their rules, moderation and conduct are their own.</p>
        <p>If you own a listed server and want it <Special>removed</Special>, or you are a player who wants your in-game name and statistics removed, contact us and we will take care of it. Details are in our <CLink href="/privacy-policy">privacy policy</CLink>.</p>

        <LegalBlock title="Claiming a Server">
            <p>Claiming a server on TMC requires proving control of it through a short-lived <Special>claim token</Special>. Claiming a server you do not control, or attempting to seize a listing from its rightful owner, is a violation of these terms.</p>
        </LegalBlock>
    </LegalSection>

    <LegalSection title="Moderation & Enforcement" icon={Gavel}>
        <p>We would rather talk to you than ban you. Where a rule has been broken unintentionally, we will normally reach out first.</p>
        <p>That said, we reserve the right to <Special>hide</Special>, <Special>edit</Special> or <Special>remove</Special> content, and to <Special>restrict</Special>, <Special>suspend</Special> or <Special>terminate</Special> accounts that violate these terms. Serious violations — malware, illegal content, attacks on our infrastructure — are acted on immediately and without warning.</p>

        <LegalBlock title="Appeals">
            <p>Every penalty we issue comes with a <Special>reason</Special> and an <Special>appeal thread</Special> where you can talk directly to our staff. If you believe an action was a mistake, use it. We do reverse decisions when we get them wrong.</p>
        </LegalBlock>

        <LegalBlock title="Reporting">
            <p>If you see something that breaks these rules, <Special>report it</Special>. Reports go to our moderation staff and are not visible to the reported party{"'"}s audience. Filing reports in bad faith — to harass a creator or bury a competitor — is itself a violation.</p>
        </LegalBlock>

        <LegalBlock title="Telling You Why">
            <p>When we remove or restrict something you posted, we will tell you <Special>what</Special> was actioned, <Special>why</Special>, whether the decision was made by a person or by an automated system, and <Special>how to challenge it</Special>. That is what the appeal thread is for, and it is a standing commitment rather than a courtesy — it is also what the EU Digital Services Act requires of us.</p>
        </LegalBlock>

        <LegalBlock title="Copyright Complaints">
            <p>If you believe content on TMC infringes your copyright, send a notice to <CLink href="mailto:contact@moddingcommunity.com">contact@moddingcommunity.com</CLink> containing all of the following. These are the elements US law (17 U.S.C. § 512(c)(3)) requires, and an incomplete notice may be one we cannot act on:</p>
            <ul>
                <li>A <Special>physical or electronic signature</Special> of the copyright owner, or of somebody authorised to act for them.</li>
                <li>Identification of the <Special>work</Special> you say has been infringed — or, for multiple works, a representative list.</li>
                <li>A <Special>link</Special> to the infringing material on our services, precise enough for us to find it.</li>
                <li>Your <Special>contact details</Special>: name, address, telephone number and email address.</li>
                <li>A statement that you have a <Special>good-faith belief</Special> the use is not authorised by the copyright owner, its agent, or the law.</li>
                <li>A statement, <Special>under penalty of perjury</Special>, that the information in your notice is accurate and that you are the owner or authorised to act for them.</li>
            </ul>
            <p>We act on valid notices promptly and tell the uploader what was removed and why.</p>
            <p>If your content was removed and you believe that was a mistake or a misidentification, send a <Special>counter-notice</Special> with your signature, identification of the removed material and where it appeared, a statement under penalty of perjury that you have that good-faith belief, your contact details, and your consent to the jurisdiction of the appropriate court. We will forward it to the complainant and may restore the material after the statutory waiting period unless they file suit.</p>
            <p>Knowingly filing a <Special>false</Special> notice or counter-notice carries liability under US law, and is separately a violation of these terms. Members who <Special>repeatedly infringe</Special> the copyright of others will lose their accounts.</p>
        </LegalBlock>
    </LegalSection>

    <LegalSection title="The Service Itself" icon={Wrench}>
        <LegalBlock title="Availability">
            <p>TMC is provided <Special>as is</Special> and <Special>as available</Special>. We are actively developing it, which means features will change, appear, and occasionally break. We do not guarantee uninterrupted availability, and we may modify or discontinue any part of the service.</p>
            <p>We make backups and we take reliability seriously, but you should <Special>keep your own copies</Special> of anything you cannot afford to lose. Do not treat TMC as your only backup of your work.</p>
        </LegalBlock>

        <LegalBlock title="Downloads Are at Your Own Risk">
            <p>Mods and assets on TMC are <Special>created by community members</Special>, not by us. We moderate what we can and remove what we find, but we cannot review every file. Nothing we host should be treated as verified or endorsed by us.</p>
            <p>Modifying a game can break saves, violate a publisher{"'"}s terms, or get you banned from that game{"'"}s official services. That is <Special>your call to make</Special>, and your responsibility.</p>
        </LegalBlock>

        <LegalBlock title="Third-Party Services & Links">
            <p>Our services link to and integrate with third parties — Discord, Steam, GitHub, Google, external repositories and game servers. We do <Special>not control</Special> those services and are not responsible for their content, availability or practices. Your use of them is governed by their own terms.</p>
        </LegalBlock>

        <LegalBlock title="Trademarks & Non-Affiliation">
            <p>The Modding Community is an <Special>independent, community-run project</Special>. We are <Special>not affiliated with, endorsed by, sponsored by, or otherwise connected to</Special> any of the game developers or publishers whose titles we support.</p>
            <p>That includes — but is not limited to — <CLink href="https://www.valvesoftware.com/en/" target="_blank">Valve</CLink>, <CLink href="https://facepunch.com/" target="_blank">Facepunch Studios</CLink>, <CLink href="https://projectzomboid.com/blog/about-us/" target="_blank">The Indie Stone</CLink>, <CLink href="https://www.bohemia.net/" target="_blank">Bohemia Interactive</CLink> and <CLink href="https://tripwireinteractive.com/" target="_blank">Tripwire Interactive</CLink>. Their games, logos and trademarks belong to them, and are referenced here purely <Special>descriptively</Special> — to identify which game a mod, asset or server relates to. We hold these studios in <Special>high regard</Special>; their willingness to support modding is the reason communities like ours exist at all.</p>
            <p>The same applies to other <Special>modding platforms and install sources</Special>. TMC is not affiliated with <CLink href="https://www.nexusmods.com/" target="_blank">Nexus Mods</CLink>, <CLink href="https://www.curseforge.com/" target="_blank">CurseForge</CLink>, <CLink href="https://gamebanana.com/" target="_blank">GameBanana</CLink>, <CLink href="https://thunderstore.io/" target="_blank">Thunderstore</CLink>, the <CLink href="https://steamcommunity.com/workshop/" target="_blank">Steam Workshop</CLink> or any similar service. Where a mod or asset on TMC points at one of those platforms as an install source, that is a <Special>reference</Special>, not a partnership. We have <Special>enormous respect</Special> for the work those teams have done for modding over the years — we see them as peers in the same ecosystem, not competitors — and we make no claim over their content, branding or communities.</p>
            <p>If you represent a studio or platform named on our services and would like something changed, corrected or removed, contact us and we will work with you.</p>
        </LegalBlock>

        <LegalBlock title="No Warranty">
            <p>To the fullest extent permitted by law, our services are provided <Special>without warranties of any kind</Special>, whether express or implied — including any implied warranty of <Special>merchantability</Special>, <Special>fitness for a particular purpose</Special>, <Special>title</Special> or <Special>non-infringement</Special>. We do not warrant that the service will be uninterrupted, error-free or secure, that defects will be corrected, or that any file hosted here is free of harmful code.</p>
            <p>Some jurisdictions do not allow the exclusion of implied warranties, in which case the exclusions above apply only to the extent that jurisdiction permits.</p>
        </LegalBlock>

        <LegalBlock title="Liability">
            <p>To the fullest extent permitted by law, TMC and its staff are <Special>not liable</Special> for indirect, incidental, special, punitive or consequential damages arising from your use of our services — including lost data, lost profits, lost goodwill, damage caused by content you downloaded, or the conduct of any third party on or through our services.</p>
            <p>Where liability cannot be excluded, our total aggregate liability to you for all claims arising out of or relating to the service is limited to the <Special>greater of</Special> the amount you paid us in the <Special>twelve months</Special> before the claim arose, or <Special>fifty US dollars</Special>.</p>
            <p>Nothing in these terms limits liability that cannot lawfully be limited — including for death or personal injury caused by negligence, or for fraud — and nothing here affects consumer rights you have under the law where you live.</p>
        </LegalBlock>

        <LegalBlock title="Indemnity">
            <p>You agree to <Special>indemnify and hold harmless</Special> TMC and its staff from any claim, demand, loss or reasonable legal cost brought by a third party arising out of content you published, your breach of these terms, your infringement of somebody else's rights, or your misuse of our API or an integration credential.</p>
            <p>This does not apply to the extent the claim arises from <Special>our</Special> own wrongdoing, and we will tell you promptly about any claim we ask you to cover and let you participate in defending it.</p>
        </LegalBlock>

        <LegalBlock title="Feedback & Suggestions">
            <p>If you send us a feature request, bug report or suggestion — through the feedback board, Discord or anywhere else — you grant us an unrestricted, royalty-free right to <Special>use it without obligation</Special>. We are not agreeing to keep it confidential, to implement it, or to compensate you for it. This applies to the <span class="italic">idea</span> only, and never to code, art or any other work you publish on the platform.</p>
        </LegalBlock>
    </LegalSection>

    <LegalSection title="Governing Law & Disputes" icon={Landmark}>
        {governingState ? (
            <p>These terms, and any dispute arising out of them or out of your use of our services, are governed by the laws of the <Special>United States</Special> and of the State of <Special>{governingState}</Special>, without regard to conflict-of-law rules. The state and federal courts located in {governingState} have jurisdiction over any such dispute, and you consent to venue there.</p>
        ) : (
            <p>These terms, and any dispute arising out of them or out of your use of our services, are governed by the laws of the <Special>United States</Special>, without regard to conflict-of-law rules. We do not impose an exclusive forum on you: a dispute may be brought wherever the applicable law already allows it to be brought.</p>
        )}
        <p>If you are a <Special>consumer</Special> resident in the EU, the UK, or anywhere else whose law grants you the right to bring proceedings in your own courts and to the protection of your own mandatory consumer law, <Special>that right is untouched by this section</Special>. Nothing here deprives you of it.</p>

        <LegalBlock title="Talk to Us First">
            <p>Before starting formal proceedings, please contact us and give us <Special>30 days</Special> to resolve the matter. Most disputes we have ever had ended in an email thread, and we would like to keep it that way.</p>
        </LegalBlock>

        <LegalBlock title="Time Limit">
            <p>Any claim arising out of these terms or your use of our services must be brought within <Special>one year</Special> of the events giving rise to it, except where the law where you live provides a longer period that cannot be shortened by agreement.</p>
        </LegalBlock>
    </LegalSection>

    <LegalSection title="General Terms" icon={Gavel}>
        <ul>
            <li><Special>Entire agreement.</Special> These terms, together with our <CLink href="/privacy-policy">privacy policy</CLink>, are the whole agreement between us about our services, and replace anything said before.</li>
            <li><Special>Severability.</Special> If any provision is found unenforceable, it is narrowed to what is enforceable and the rest of the terms remain in effect.</li>
            <li><Special>No waiver.</Special> If we do not enforce a provision on one occasion, we have not given up the right to enforce it later.</li>
            <li><Special>Assignment.</Special> You may not transfer your account or your rights under these terms without our consent. We may assign these terms to a successor if the project changes hands, and will tell you if that happens.</li>
            <li><Special>No third-party beneficiaries.</Special> These terms create rights only between you and us.</li>
