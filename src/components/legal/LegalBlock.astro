---
/**
 * A sub-block inside a <LegalSection> — a slightly raised inner panel, so a
 * long section reads as a handful of discrete topics instead of one wall of
 * text.
 */
type Props = {
    title?: string
    class?: string
}

const { title, class: className } = Astro.props as Props
---

<div
    class={`flex flex-col gap-3 rounded-xl border border-border/70 bg-surface-secondary/60 p-4 @2xl:p-5 ${className ?? ""}`}
>
    {title && <h4 class="text-lg">{title}</h4>}
    <div class="legal-prose flex flex-col gap-3">
        <slot />
    </div>
</div>
