---
import { CalendarClock } from "lucide-react"

/**
 * Shell for the legal pages (ToS, privacy policy, licenses).
 *
 * Supplies the page padding + measure that `<main>` deliberately does not, a
 * hero block for the title/intro, and — on wide screens — a sticky "on this
 * page" rail built from the <LegalSection> elements in the default slot.
 */
type Props = {
    title: string
    /** Small accent label above the title. */
    eyebrow?: string
    lastUpdated?: string
    lastUpdatedLabel?: string
}

const {
    title,
    eyebrow,
    lastUpdated,
    lastUpdatedLabel = "Last updated"
} = Astro.props as Props
---

<div class="container mx-auto px-4 py-10 @2xl:px-6 @5xl:py-14">
    <div class="flex flex-col gap-8 @5xl:flex-row @5xl:items-start @5xl:gap-10">
        <div class="flex min-w-0 max-w-4xl grow flex-col gap-6">
            <header
                class="relative overflow-hidden rounded-2xl border border-border bg-surface p-6 @2xl:p-8"
            >
                {/* Soft accent wash behind the title, matching the landing hero. */}
                <div
                    class="pointer-events-none absolute inset-x-0 -top-32 h-56 bg-gradient-to-b from-accent/20 to-transparent blur-2xl"
                    aria-hidden="true"
                >
                </div>
                <div class="relative flex flex-col gap-4">
                    {eyebrow && (
                        <span
                            class="inline-flex items-center gap-2 text-xs font-semibold tracking-wider text-accent uppercase"
                        >
                            <span
                                class="h-1 w-6 rounded-full bg-gradient-to-r from-accent to-[#5577f0]"
                            ></span>
                            {eyebrow}
                        </span>
                    )}
                    <h2 class="text-3xl @2xl:text-4xl">{title}</h2>
                    <div class="legal-prose flex max-w-3xl flex-col gap-3">
                        <slot name="lede" />
                    </div>
                    {lastUpdated && (
                        <span
                            class="inline-flex w-fit items-center gap-2 rounded-full border border-border bg-surface-secondary px-3 py-1 text-xs text-muted"
                        >
                            <CalendarClock className="h-3.5 w-3.5 text-accent" />
                            {lastUpdatedLabel}: <span class="font-medium text-foreground">{lastUpdated}</span>
                        </span>
                    )}
                </div>
            </header>

            <div class="flex flex-col gap-6">
                <slot />
            </div>
        </div>

        {/*
            `@5xl:self-stretch` is what makes the rail below actually STICK.

            A `position: sticky` element travels inside its PARENT's content
            box, and the row above sets `@5xl:items-start` — so this <aside>
            took its height from its own content, which is the sticky panel and
            nothing else. Parent 556px tall, child 556px tall: no room to
            travel, so the panel scrolled away with the page like any static
            box and the "on this page" rail was gone by the second screen. It
            looked correct in every screenshot, because at scroll 0 a sticky
            element that cannot stick is exactly where it should be.

            Stretching the aside to the row's full height gives the panel the
            whole article to travel down. `self-stretch` on this item rather
            than dropping `items-start` from the row, so the alignment of the
            article column beside it is untouched.
        */}
        <aside class="hidden shrink-0 @5xl:block @5xl:w-64 @5xl:self-stretch" data-legal-toc>
            <div
                class="sticky top-20 flex max-h-[calc(100vh-6rem)] flex-col gap-3 overflow-y-auto rounded-2xl border border-border bg-surface p-4"
            >
                <span class="text-xs font-semibold tracking-wider text-muted uppercase">
                    On this page
                </span>
                <nav class="flex flex-col gap-0.5 text-sm" data-legal-toc-list></nav>
            </div>
        </aside>
    </div>
</div>

<style>
    /* Only reveal the rail once the script has actually filled it in. */
    [data-legal-toc]:not([data-ready]) {
        display: none;
    }
</style>

<script>
    const aside = document.querySelector<HTMLElement>("[data-legal-toc]")
    const list = aside?.querySelector<HTMLElement>("[data-legal-toc-list]")
    const sections = Array.from(
        document.querySelectorAll<HTMLElement>("[data-legal-section]")
    )

    if (aside && list && sections.length) {
        const activeClasses = ["border-accent", "bg-accent/10", "text-foreground", "font-medium"]

        const links = sections.map((section) => {
            const link = document.createElement("a")

            link.href = `#${section.id}`
            link.textContent = section.dataset.tocTitle ?? ""

            /*
             * The rail is built here at run time, so it is not in the HTML and
             * cannot carry a `data-umami-event` the way a static anchor does —
             * and every entry is a `#hash`, which produces no pageview and no
             * request. Without this the whole control is invisible.
             *
             * The section's ID and its index, never `tocTitle`: the title is
             * translated prose and one section would be nine rows.
             */
            link.addEventListener("click", () => {
                try {
                    window.umami?.track("legal_toc_click", {
                        section: section.id,
                        index: sections.indexOf(section) + 1,
                        of: sections.length,
                        path: window.location.pathname,
                    })
                } catch {
                    /* Analytics must never break a page. */
                }
            })
            link.className =
                "rounded-r-lg border-l-2 border-transparent px-3 py-1.5 text-muted no-underline transition-colors hover:bg-surface-secondary hover:text-foreground"

            list.appendChild(link)

            return link
        })

        aside.dataset.ready = "1"

        // Highlight whichever section the reader is currently inside.
        let current = -1

        const sync = () => {
            let next = 0

            sections.forEach((section, i) => {
                if (section.getBoundingClientRect().top <= 96) next = i
            })

            if (next === current) return

            if (current >= 0) links[current].classList.remove(...activeClasses)
            links[next].classList.add(...activeClasses)

            current = next
        }

        let queued = false

        const onScroll = () => {
            if (queued) return

            queued = true

            requestAnimationFrame(() => {
                queued = false
                sync()
            })
        }

        sync()

        window.addEventListener("scroll", onScroll, { passive: true })
        window.addEventListener("resize", onScroll, { passive: true })

        /*
         * How far down the policy anybody actually reads — the one number
         * people ask about a legal page, and one a pageview cannot answer
         * because the whole document is a single URL.
         *
         * A high-water mark reported ONCE, not a row per section like the
         * landing page's `section_view`. A policy is read top to bottom or
         * abandoned, so the interesting figure is where it stopped; fourteen
         * rows per visit would be the same fact spelled expensively.
         *
         * `visibilitychange` on `hidden`, not `beforeunload`: a page hidden by
         * a tab switch or a phone locking is the last moment guaranteed to
         * run on mobile, where `beforeunload` is unreliable and `unload` has
         * been unreliable for years. `sent` guards the double fire you get
         * from hiding and then genuinely leaving.
         */
        let deepest = 0
        let sent = false

        const mark = () => {
            if (current + 1 > deepest) deepest = current + 1
        }

        window.addEventListener("scroll", mark, { passive: true })

        document.addEventListener("visibilitychange", () => {
            if (document.visibilityState !== "hidden" || sent) return

            sent = true

            try {
                window.umami?.track("legal_depth", {
                    deepest,
                    of: sections.length,
                    section: sections[Math.max(0, deepest - 1)]?.id,
                    path: window.location.pathname,
                })
            } catch {
                /* Analytics must never break a page. */
            }
        })
    }
</script>
