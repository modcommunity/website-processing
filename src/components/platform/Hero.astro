---
import { Gamepad2, Package, Scale } from 'lucide-react';
import HeroBackdrop from "../helper/HeroBackdrop.astro";
import PlatformPanel from "./PlatformPanel.astro";
import { getT } from "../../i18n/t";

const t = getT(Astro.currentLocale);
const p = (k: string) => t(`landing.platformPage.${k}`);
const chips = [p('chipEngine'), p('chipWeb'), p('chipServers')];
---

{/*
  * Two columns like /tmc-app: copy left, the stack panel right. The headline
  * is a plain statement of what Dot is and stays at the page-title scale of
  * the other heroes (two lines at desktop width), not a slogan at display
  * size. The licence badge still opens the copy: it is the one claim on the
  * page that is easy to check.
  */}
<section class="px-4 pt-8 @2xl:pt-12">
    <div class="container mx-auto">
        <div class="relative isolate overflow-hidden rounded-3xl border border-white/10 shadow-2xl shadow-black/40">
            <HeroBackdrop variant="blueprint" />

            <div class="@container px-6 py-12 @2xl:py-16">
                <div class="grid min-w-0 items-center gap-10 @3xl:grid-cols-[minmax(0,1.1fr)_minmax(0,1fr)] @3xl:gap-12">
                    <div class="flex min-w-0 flex-col items-start gap-5">
                        <div class="flex flex-wrap items-center gap-2">
                            <span class="inline-flex items-center gap-2 rounded-full border border-emerald-300/30 bg-emerald-300/10 px-3 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-emerald-200">
                                <Scale className="h-3.5 w-3.5" />
                                {p('badgeMit')}
                            </span>
                            <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-3 py-1 text-[0.68rem] font-semibold uppercase tracking-[0.14em] text-white/75">
                                <span class="h-1.5 w-1.5 rounded-full bg-amber-300"></span>
                                {p('badgeStage')}
                            </span>
                        </div>

                        <h2
                            class="text-balance font-pjs text-3xl font-extrabold leading-[1.12] tracking-tight text-white @2xl:text-4xl [&_.special]:text-[#93c5fd]"
                            set:html={p('heroTitleHtml')}
                        ></h2>

                        <p
                            class="max-w-xl text-pretty leading-relaxed text-white/70 [&_.special]:text-[#93c5fd]"
                            set:html={p('heroTaglineHtml')}
                        ></p>

                        <ul class="flex flex-wrap gap-2">
                            {chips.map((chip) => (
                                <li class="rounded-md border border-white/12 bg-white/[0.06] px-2.5 py-1 text-sm text-white/75">{chip}</li>
                            ))}
                        </ul>

                        <div class="flex flex-wrap items-center gap-3 pt-1">
                            <a
                                href="#addons"
                                data-umami-event="platform_page_cta" data-umami-event-to="addons" data-umami-event-place="hero"
                                class="inline-flex items-center justify-center gap-2 rounded-lg bg-white px-5 py-2.5 font-semibold text-[#05060f] shadow-lg shadow-black/30 transition hover:bg-white/90"
                            >
                                <Package className="h-5 w-5" />
                                <span>{p('heroBtnAddons')}</span>
                            </a>
                            <a
                                href="#projects"
                                data-umami-event="platform_page_cta" data-umami-event-to="projects" data-umami-event-place="hero"
                                class="inline-flex items-center justify-center gap-2 rounded-lg border border-white/20 px-5 py-2.5 font-semibold text-white/90 transition hover:border-white/45 hover:bg-white/5"
                            >
                                <Gamepad2 className="h-5 w-5" />
                                <span>{p('heroBtnGames')}</span>
                            </a>
                        </div>

                        <p
                            class="max-w-xl text-sm text-white/55 [&_.special]:text-amber-200"
                            set:html={p('heroNoteHtml')}
                        ></p>
                    </div>

                    <div class="min-w-0">
                        <PlatformPanel />
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>
