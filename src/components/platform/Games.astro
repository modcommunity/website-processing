---
import { ExternalLink } from 'lucide-react';
import SectionIntro from "../landing/helper/SectionIntro.astro";
import { GAMES, GAMES_ORG } from "./data";
import { getT } from "../../i18n/t";

const t = getT(Astro.currentLocale);
const p = (k: string) => t(`landing.platformPage.${k}`);
---

<section class="py-20 px-4 container mx-auto flex flex-col gap-10">
    <SectionIntro eyebrow={p('gamesEyebrow')}>
        <h2 slot="title" set:html={p('gamesTitleHtml')}></h2>
        <p set:html={p('gamesIntroHtml')}></p>
    </SectionIntro>
    <ul class="grid grid-cols-1 gap-4 @3xl:grid-cols-2 @5xl:grid-cols-3">
        {GAMES.map((g) => (
            <li class="min-w-0 intersect-once intersect:motion-preset-slide-up">
                <a
                    href={`${GAMES_ORG}/${g.repo}`} target="_blank" rel="noreferrer"
                    class="group flex h-full min-w-0 flex-col gap-1 rounded-xl border border-border bg-surface p-4 transition hover:-translate-y-0.5 hover:border-accent/40 motion-reduce:transition-none motion-reduce:hover:translate-y-0"
                >
                    <span class="flex items-center justify-between gap-2">
                        <code class="truncate text-sm font-semibold text-accent">{g.id}</code>
                        <ExternalLink className="h-3.5 w-3.5 shrink-0 text-muted" />
                    </span>
                    <span class="text-sm text-muted">{p(`gm_${g.id}`)}</span>
                </a>
            </li>
        ))}
    </ul>
    <p class="max-w-3xl text-sm text-muted" set:html={p('gamesNoteHtml')}></p>
</section>
