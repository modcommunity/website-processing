---
import SectionIntro from "../landing/helper/SectionIntro.astro";
import { getT } from "../../i18n/t";

const t = getT(Astro.currentLocale);
const p = (k: string) => t(`landing.platformPage.${k}`);

/** Aims, not status: `goal_h<n>` is the heading and `goal_b<n>` the sentence or two under it. */
const GOALS = 8;
---

<section id="goals" class="scroll-mt-20 py-20 px-4 container mx-auto flex flex-col gap-10">
    <SectionIntro eyebrow={p('goalsEyebrow')}>
        <h2 slot="title" set:html={p('goalsTitleHtml')}></h2>
        <p set:html={p('goalsIntroHtml')}></p>
    </SectionIntro>
    <ol class="grid grid-cols-1 gap-4 @3xl:grid-cols-2 @5xl:grid-cols-3">
        {Array.from({ length: GOALS }, (_, i) => (
            <li class="flex min-w-0 flex-col gap-2 rounded-2xl border border-border bg-surface p-5 intersect-once intersect:motion-preset-slide-up">
                <span class="flex h-7 w-7 items-center justify-center rounded-full bg-accent/10 text-xs font-semibold text-accent">{i + 1}</span>
                <h3 class="text-base font-semibold">{p(`goal_h${i + 1}`)}</h3>
                <p class="text-sm text-muted">{p(`goal_b${i + 1}`)}</p>
            </li>
        ))}
    </ol>
</section>
