---
import { Gamepad2, Globe, Package } from 'lucide-react';
import { getT } from "../../i18n/t";

/**
 * The Dot stack as a small window: the same three layers as /platform's
 * diagram, drawn with real repository names so it reads as the thing itself
 * rather than as a diagram of it. Markup plus CSS keyframes, no script and no
 * island: it sits in two heroes and must not cost either one a hydration.
 *
 * The motion is a light that walks along the chips, one at a time, and a
 * pulse on the status dot. It lives in `@media (prefers-reduced-motion:
 * no-preference)`, so a reader who asked for none gets the finished panel.
 * The names are not translated; the three layer titles and the three product
 * names are (`landing.platformPage.*`).
 */
const t = getT(Astro.currentLocale);
const p = (k: string) => t(`landing.platformPage.${k}`);

const rows = [
    { icon: Gamepad2, title: p('gameTitle'), chips: ['game-arena', 'game-hungario', 'mg-prop-hunt'] },
    { icon: Package, title: p('dotTitle'), chips: ['dot-auth', 'dot-server', 'dot-party', 'dot-moderation', 'dot-voice', 'dot-net'], hot: true },
    { icon: Globe, title: p('tmcTitle'), chips: [p('pnPlay'), p('pnServers'), p('pnPacks'), p('pnWorkshop')] },
];
let n = 0;
---

<div class="@container min-w-0">
    <div class="pp relative overflow-hidden rounded-2xl border border-sky-300/25 bg-[#070b1d]/80 shadow-2xl shadow-sky-950/50 ring-1 ring-white/5 backdrop-blur-md">
        <div class="flex items-center gap-2 border-b border-white/10 px-4 py-2.5">
            <span class="h-2.5 w-2.5 rounded-full bg-white/20"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-white/20"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-white/20"></span>
            <span class="ml-2 min-w-0 truncate font-mono text-xs text-white/50">project.godot</span>
            <span class="ml-auto inline-flex shrink-0 items-center gap-1.5 font-mono text-[0.65rem] text-emerald-300/90">
                <span class="pp-pulse h-1.5 w-1.5 rounded-full bg-emerald-300"></span>dot-server
            </span>
        </div>

        <div class="flex flex-col gap-1 p-4">
            {rows.map((row, ri) => (
                <>
                    {ri > 0 && (
                        <span aria-hidden="true" class="pp-wire relative mx-auto h-5 w-px bg-gradient-to-b from-white/10 to-sky-300/60"></span>
                    )}
                    <div class:list={['rounded-xl border px-3 py-3', row.hot ? 'border-sky-300/35 bg-sky-300/[0.07]' : 'border-white/10 bg-white/[0.03]']}>
                        <div class="mb-2 flex items-center gap-2 text-xs font-semibold text-white/80">
                            <row.icon className={row.hot ? 'h-4 w-4 text-sky-300' : 'h-4 w-4 text-white/50'} />
                            <span class="min-w-0 truncate">{row.title}</span>
                        </div>
                        <div class="flex flex-wrap gap-1.5">
                            {row.chips.map((chip) => (
                                <span class="pp-chip rounded-md border border-white/12 bg-white/[0.06] px-2 py-1 font-mono text-[0.7rem] text-white/75" style={`--pp-i:${n++}`}>{chip}</span>
                            ))}
                        </div>
                    </div>
                </>
            ))}
        </div>
    </div>
</div>

<style>
    @media (prefers-reduced-motion: no-preference) {
        .pp-chip {
            animation: pp-light 12s ease-in-out infinite;
            animation-delay: calc(var(--pp-i) * 0.9s);
        }
        .pp-pulse {
            animation: pp-pulse 2.4s ease-in-out infinite;
        }
        .pp-wire::after {
            content: '';
            position: absolute;
            left: -1px;
            width: 3px;
            height: 3px;
            border-radius: 9999px;
            background: #7dd3fc;
            box-shadow: 0 0 6px 1px #7dd3fc;
            animation: pp-flow 2.4s linear infinite;
        }
    }
    @keyframes pp-light {
        0%, 12%, 100% { border-color: rgb(255 255 255 / 0.12); background-color: rgb(255 255 255 / 0.06); color: rgb(255 255 255 / 0.75); }
        4%, 8% { border-color: rgb(125 211 252 / 0.8); background-color: rgb(125 211 252 / 0.18); color: #fff; }
    }
    @keyframes pp-pulse {
        0%, 100% { opacity: 1; box-shadow: 0 0 0 0 rgb(110 231 183 / 0.5); }
        50% { opacity: 0.55; box-shadow: 0 0 0 4px rgb(110 231 183 / 0); }
    }
    @keyframes pp-flow {
        from { top: 0; opacity: 0; }
        20%, 80% { opacity: 1; }
        to { top: calc(100% - 3px); opacity: 0; }
    }
</style>
