---
import SectionIntro from "../landing/helper/SectionIntro.astro";
import { getT } from "../../i18n/t";

const t = getT(Astro.currentLocale);
const p = (k: string) => t(`landing.platformPage.${k}`);

/**
 * The steps of running a server with dot-server-deploy. The commands are the
 * ones its README gives and are never translated; the sentences are
 * `run<n>t` / `run<n>b`. Step 5 is on the website, so it has no command.
 */
const steps: { n: number; cmd?: string[] }[] = [
    { n: 1, cmd: ['git clone https://github.com/modcommunity/dot-server-deploy', 'cd dot-server-deploy'] },
    { n: 2, cmd: ['./setup.sh'] },
    { n: 3, cmd: ['./server --games arena', '# or, with Docker', 'docker compose up -d'] },
    { n: 4, cmd: ['./setup.sh --full'] },
    { n: 5 },
    { n: 6, cmd: ['cfg/content.yml', 'cfg/packs.yml'] },
];
---

<section id="run-a-server" class="scroll-mt-20 py-20 px-4 container mx-auto flex flex-col gap-10">
    <SectionIntro eyebrow={p('runEyebrow')}>
        <h2 slot="title" set:html={p('runTitleHtml')}></h2>
        <p set:html={p('runIntroHtml')}></p>
    </SectionIntro>

    <ol class="flex flex-col gap-4">
        {steps.map(({ n, cmd }) => (
            <li class="@container min-w-0 intersect-once intersect:motion-preset-slide-up">
                <div class="grid min-w-0 grid-cols-1 gap-4 rounded-2xl border border-border bg-surface p-5 @3xl:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] @3xl:items-center">
                    <div class="flex min-w-0 gap-4">
                        <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-accent/10 text-sm font-semibold text-accent">{n}</span>
                        <div class="min-w-0">
                            <h3 class="text-base font-semibold">{p(`run${n}t`)}</h3>
                            <p class="mt-1 text-sm text-muted [&_code]:text-foreground" set:html={p(`run${n}b`)}></p>
                        </div>
                    </div>
                    {cmd && (
                        <pre class="min-w-0 overflow-x-auto rounded-xl border border-border bg-background/60 p-3 font-mono text-xs leading-relaxed text-foreground"><code>{cmd.join('\n')}</code></pre>
                    )}
                </div>
            </li>
        ))}
    </ol>
</section>
