---
import { Code2 } from 'lucide-react';
// OS logos are brand marks, the one category lucide has no glyphs for.
import { FaApple, FaLinux, FaWindows } from 'react-icons/fa6';
import HeroBackdrop from "../helper/HeroBackdrop.astro";
import DownloadButton from "./DownloadButton";
import AppWindow from "./mock/AppWindow";
import { getT } from "../../i18n/t";
import { APP_REPO } from "./links";
import { dlLabels } from "./dlLabels";

const t = getT(Astro.currentLocale);
const platforms = [
    { icon: FaWindows, label: 'Windows' },
    { icon: FaLinux, label: 'Linux' },
    { icon: FaApple, label: 'macOS' },
];
---

{/* Copy and the Download button on the left, a self-running drawing of the app
    on the right. The drawing is aria-hidden: the claims are in the copy. */}
<section class="px-4 pt-8 @2xl:pt-12">
    <div class="container mx-auto">
        <div class="relative isolate overflow-hidden rounded-3xl border border-white/10 shadow-2xl shadow-black/40">
            <HeroBackdrop variant="workshop" />

            <div class="@container grid grid-cols-1 items-center gap-10 px-6 py-14 @5xl:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)] @2xl:py-20">
                <div class="flex min-w-0 flex-col items-start gap-5 text-left">
                    <span class="inline-flex items-center gap-2 rounded-full border border-white/15 bg-white/10 px-4 py-1.5 text-[0.7rem] font-semibold uppercase tracking-[0.16em] text-white/75 backdrop-blur-md">
                        <span class="h-1.5 w-1.5 rounded-full bg-violet-300 shadow-[0_0_8px_2px] shadow-violet-300/60"></span>
                        {t('landing.tmcApp.heroBadge')}
                    </span>

                    <h2
                        class="text-balance text-4xl font-extrabold leading-[1.08] tracking-tight text-white drop-shadow-xl @2xl:text-5xl @5xl:text-6xl [&_.special]:text-[#c4b5fd]"
                        set:html={t('landing.tmcApp.heroTitleHtml')}
                    ></h2>
                    <span aria-hidden class="h-px w-24 bg-gradient-to-r from-white/60 to-transparent"></span>

                    <p
                        class="max-w-xl text-pretty text-lg text-white/75 [&_.special]:text-[#c4b5fd]"
                        set:html={t('landing.tmcApp.heroTaglineHtml')}
                    ></p>

                    <DownloadButton client:load labels={dlLabels(t)} variant="hero" place="hero" />

                    <div class="flex flex-wrap items-center gap-2">
                        {platforms.map(({ icon: Icon, label }) => (
                            <span class="inline-flex items-center gap-2 rounded-lg border border-white/12 bg-white/8 px-3 py-1.5 text-sm text-white/80 backdrop-blur-md">
                                <Icon className="h-4 w-4 text-violet-200" />
                                {label}
                            </span>
                        ))}
                        <span class="inline-flex items-center rounded-lg border border-white/12 bg-white/8 px-3 py-1.5 text-sm font-semibold text-white/80 backdrop-blur-md">GPL-3.0</span>
                    </div>
                    <p class="text-xs text-white/55">{t('landing.tmcApp.heroMobile')}</p>

                    <a
                        href={APP_REPO}
                        data-umami-event="app_page_cta"
                        data-umami-event-to="repo"
                        data-umami-event-place="hero"
                        target="_blank"
                        rel="noreferrer"
                        class="inline-flex items-center gap-2 text-sm font-semibold text-white/80 underline-offset-4 transition hover:text-white hover:underline"
                    >
                        <Code2 className="h-4 w-4" />
                        {t('landing.tmcApp.heroSource')}
                    </a>
                </div>

                <div class="min-w-0">
                    <AppWindow client:load screens={['apps', 'play', 'servers']} autoplay caption={t('landing.tmcApp.heroMockNote')} />
                </div>
            </div>
        </div>
    </div>
</section>
