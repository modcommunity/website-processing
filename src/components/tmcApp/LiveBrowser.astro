---
import { Activity, CircleCheck, Clock, Filter, Gauge, LineChart, Radio, ShieldCheck, TerminalSquare } from 'lucide-react';
import SectionIntro from "../landing/helper/SectionIntro.astro";
import FeatureCard from "../landing/helper/FeatureCard.astro";
import { getT } from "../../i18n/t";


const t = getT(Astro.currentLocale);

// The planned server-administration work, in the order the panel lists it.
const planned = [
    t('landing.tmcApp.srvAdminL1'),
    t('landing.tmcApp.srvAdminL2'),
    t('landing.tmcApp.srvAdminL3'),
    t('landing.tmcApp.srvAdminL4'),
];

/*
 * The thirteen protocols `tmc-core`'s net/query module implements, in the order
 * its table lists them. GameSpy 4 shares v3's implementation and is tagged
 * separately, which is why both appear. Static on purpose — this is an
 * illustration of the feature, not a feed.
 */
const protocols = [
    "A2S", "Minecraft", "Minecraft SLP", "Quake III", "GameSpy 1", "GameSpy 2",
    "GameSpy 3", "GameSpy 4", "SA-MP", "FiveM", "Frostbite", "TeamSpeak 3",
    "Hytale (Nitrado)",
];

// A plausible run of recent readings for the latency ladder, in ms. Hand-picked
// so the sparkline has a visible spike — the whole point of keeping a history.
const readings = [24, 22, 25, 23, 21, 26, 24, 23, 58, 31, 25, 24, 22, 23, 25, 24, 21, 23, 22, 23];
const worst = Math.max(...readings);
---

<section class="py-20 px-4 container mx-auto flex flex-col gap-10">
    <SectionIntro eyebrow={t('landing.tmcApp.liveEyebrow')}>
        <h2 slot="title" set:html={t('landing.tmcApp.liveTitleHtml')}></h2>
        <p set:html={t('landing.tmcApp.liveIntroHtml')}></p>
    </SectionIntro>

    {/*
      * Mock server row. Own `@container` so the two-column split inside it is
      * measured against this panel and not the whole page — the rule the repo's
      * CLAUDE.md spells out for anything laid out inside a column.
      */}
    <div class="@container overflow-hidden rounded-xl border border-border bg-background/70 intersect-once intersect:motion-preset-slide-up">
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-border px-4 py-3">
            <div class="flex min-w-0 items-center gap-2">
                <span class="relative flex h-2 w-2 shrink-0">
                    <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-success opacity-75"></span>
                    <span class="relative inline-flex h-2 w-2 rounded-full bg-success"></span>
                </span>
                <span class="truncate text-sm font-semibold text-foreground">{t('landing.tmcApp.liveMockName')}</span>
            </div>
            <span class="text-xs text-muted">{t('landing.tmcApp.liveMockUpdated')}</span>
        </div>

        <div class="grid grid-cols-1 gap-6 p-4 @2xl:grid-cols-2">
            <div class="flex min-w-0 flex-col gap-4">
                <p class="text-sm text-muted">{t('landing.tmcApp.liveMockMap')}</p>

                <div class="flex flex-col gap-1">
                    <div class="flex items-center justify-between text-xs">
                        <span class="text-muted">{t('landing.tmcApp.liveMockPlayers')}</span>
                        <span class="font-mono text-foreground">142 / 200</span>
                    </div>
                    <div class="h-2 w-full overflow-hidden rounded-full bg-surface-secondary">
                        <div class="h-full w-[71%] rounded-full bg-gradient-to-r from-accent to-[#5577f0]"></div>
                    </div>
                </div>

                <div class="flex items-baseline gap-2">
                    <span class="text-xs text-muted">{t('landing.tmcApp.liveMockPing')}</span>
                    <span class="font-mono text-2xl font-bold text-success">23<span class="text-sm font-normal text-muted"> ms</span></span>
                </div>

                <div class="flex flex-wrap gap-3 text-xs text-muted">
                    <span class="inline-flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-success"></span>{t('landing.tmcApp.liveL1')}</span>
                    <span class="inline-flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-warning"></span>{t('landing.tmcApp.liveL2')}</span>
                    <span class="inline-flex items-center gap-1.5"><span class="h-2 w-2 rounded-full bg-danger"></span>{t('landing.tmcApp.liveL3')}</span>
                </div>
            </div>

            {/* Latency ladder — one bar per stored reading, height relative to
                the worst of them, so the spike is the tall red one. */}
            <div class="flex min-w-0 flex-col gap-2 rounded-lg border border-border bg-surface p-3">
                <div class="flex items-center gap-2 text-xs text-muted">
                    <Activity className="h-3.5 w-3.5 text-accent" />
                    {t('landing.tmcApp.liveMockLadderTitle')}
                </div>
                <div class="flex h-24 items-end gap-1">
                    {readings.map((ms) => (
                        <span
                            class:list={[
                                "flex-1 rounded-t-sm",
                                ms > 50 ? "bg-danger/70" : ms > 30 ? "bg-warning/70" : "bg-success/60",
                            ]}
                            style={`height: ${Math.round((ms / worst) * 100)}%`}
                            title={`${ms} ms`}
                        ></span>
                    ))}
                </div>
                <div class="flex justify-between font-mono text-[11px] text-muted">
                    <span>21 ms</span>
                    <span>{worst} ms</span>
                </div>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 gap-6 @3xl:grid-cols-2 @5xl:grid-cols-3">
        <FeatureCard icon={Gauge} title={t('landing.tmcApp.c1t')} class="intersect-once intersect:motion-preset-slide-up">
            <Fragment set:html={t('landing.tmcApp.c1b')} />
        </FeatureCard>
        <FeatureCard icon={Radio} title={t('landing.tmcApp.c2t')} class="intersect-once intersect:motion-preset-slide-up">
            <Fragment set:html={t('landing.tmcApp.c2b')} />
        </FeatureCard>
        <FeatureCard icon={Filter} title={t('landing.tmcApp.c3t')} class="intersect-once intersect:motion-preset-slide-up">
            <Fragment set:html={t('landing.tmcApp.c3b')} />
        </FeatureCard>
        <FeatureCard icon={ShieldCheck} title={t('landing.tmcApp.c4t')} class="intersect-once intersect:motion-preset-slide-up">
            <Fragment set:html={t('landing.tmcApp.c4b')} />
        </FeatureCard>
        <FeatureCard icon={LineChart} title={t('landing.tmcApp.c5t')} class="intersect-once intersect:motion-preset-slide-up">
            <Fragment set:html={t('landing.tmcApp.c5b')} />
        </FeatureCard>
        <FeatureCard icon={TerminalSquare} title={t('landing.tmcApp.c6t')} class="intersect-once intersect:motion-preset-slide-up">
            <Fragment set:html={t('landing.tmcApp.c6b')} />
        </FeatureCard>
    </div>

    <div class="flex flex-col gap-3 rounded-xl border border-border bg-surface p-5">
        <span class="text-sm font-semibold text-foreground">{t('landing.tmcApp.protoTitle')}</span>
        <div class="flex flex-wrap gap-2">
            {protocols.map((p) => (
                <span class="rounded-lg border border-border bg-background/60 px-2.5 py-1 font-mono text-xs text-foreground">{p}</span>
            ))}
        </div>
        <p class="text-sm text-muted">{t('landing.tmcApp.protoNote')}</p>
    </div>

    {/*
      * Server administration, split into what exists and what does not.
      *
      * RCON is built (`src/routes/rcon.tsx` in ../../../../tmc-app); the four
      * below it are not, and the panel is shaped so that is impossible to
      * misread — one "In the app" row, then four rows each carrying a "Planned"
      * tag, then a line saying planned means planned. The rest of this page
      * describes only what is built, so anything forward-looking has to be
      * fenced off like this rather than folded into a feature card.
      */}
    <div class="flex flex-col gap-4 rounded-xl border border-border bg-surface p-5 intersect-once intersect:motion-preset-slide-up">
        <span class="text-sm font-semibold text-foreground">{t('landing.tmcApp.srvAdminTitle')}</span>

        <div class="flex items-start gap-3 rounded-lg border border-success/30 bg-success/5 p-3">
            <CircleCheck className="mt-0.5 h-4 w-4 shrink-0 text-success" />
            <div class="flex min-w-0 flex-col gap-1">
                <span class="text-[10px] font-semibold uppercase tracking-wider text-success">
                    {t('landing.tmcApp.srvAdminNowLabel')}
                </span>
                <p class="text-sm text-muted [&_.special]:text-accent" set:html={t('landing.tmcApp.srvAdminNow')}></p>
            </div>
        </div>

        <ul class="flex flex-col gap-2">
            {planned.map((html) => (
                <li class="flex items-start gap-3 rounded-lg border border-border bg-background/60 p-3">
                    <Clock className="mt-0.5 h-4 w-4 shrink-0 text-muted" />
                    <div class="flex min-w-0 grow flex-col gap-1">
                        <span class="w-fit rounded-full border border-border px-2 py-0.5 text-[10px] font-semibold uppercase tracking-wider text-muted">
                            {t('landing.tmcApp.srvAdminLaterLabel')}
                        </span>
                        <p class="text-sm text-muted [&_.special]:text-accent" set:html={html}></p>
                    </div>
                </li>
            ))}
        </ul>

        <p class="text-sm text-muted">{t('landing.tmcApp.srvAdminNote')}</p>
    </div>
</section>
