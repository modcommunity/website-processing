---
type Props = {
    src: string
    websiteId: string
    setOutboundClicks?: boolean
    /**
     * Report a light/dark switch.
     *
     * Off by default so a consumer opts in, and named for what it watches
     * rather than for the control: see the script below for why this is an
     * observer and not a click handler.
     */
    trackTheme?: boolean
    /** The event name to emit. Kept a prop so each site can use its own prefix. */
    themeEvent?: string
}

const {
    src,
    websiteId,
    setOutboundClicks = true,
    trackTheme = false,
    themeEvent = 'theme_change'
} = Astro.props as Props
---

<!-- is:inline is what Astro already does here, because the tag carries attributes.
     Stating it silences the hint and keeps the tag from being bundled if the
     attributes ever go away — this is a third-party snippet that has to load
     from Umami's origin, not something to process. -->
<!-- Drops sends from automated browsers. The same rule as website-city's
     `src/utils/umami/automation.ts` (read that for the reasoning) — both sites
     report into one website id, so the two copies must agree. Defined before the
     tracker, which looks the function up at send time via data-before-send. -->
<script is:inline>
    (() => {
        let verdict;
        const probe = () => {
            const nav = navigator;
            if (nav.webdriver === true) return true;
            const brands = (nav.userAgentData && nav.userAgentData.brands) || [];
            if (brands.some(b => /headless/i.test(b.brand))) return true;
            try {
                const gl = document.createElement('canvas').getContext('webgl');
                if (gl) {
                    const ext = gl.getExtension('WEBGL_debug_renderer_info');
                    const r = String(gl.getParameter(ext ? ext.UNMASKED_RENDERER_WEBGL : gl.RENDERER) || '');
                    const lose = gl.getExtension('WEBGL_lose_context');
                    if (lose) lose.loseContext();
                    if (/swiftshader|llvmpipe|softpipe|lavapipe/i.test(r)) return true;
                }
            } catch (e) {
                /* No WebGL is not a verdict. */
            }
            return false;
        };
        window.tmcUmamiBeforeSend = (type, payload) => {
            if (verdict === undefined) verdict = probe();
            return verdict ? null : payload;
        };
    })()
</script>
<script
    is:inline
    defer
    src={src}
    data-website-id={websiteId}
    data-before-send="tmcUmamiBeforeSend"
/>
{setOutboundClicks && (
    <script>
        (() => {
            const name = 'outbound-link-click';

            document.querySelectorAll('a').forEach(a => {

                if (a.host !== window.location.host && !a.getAttribute('data-umami-event')) {
                    a.setAttribute('data-umami-event', name);
                    a.setAttribute('data-umami-event-url', a.href);
                }
            })
        })()
    </script>
)}
{trackTheme && (
    <script is:inline data-theme-event={themeEvent}>
        (() => {
            const el = document.currentScript;
            const name = (el && el.dataset.themeEvent) || 'theme_change';
            const root = document.documentElement;

            /*
             * A MutationObserver on `data-theme`, not a click handler on the
             * toggle.
             *
             * The toggle is `@modcommunity/shared`'s `<ThemeToggle/>` and it
             * takes no `onChange` — adding one would mean a release of that
             * package and a matching bump in three consumers to record one
             * click. What it DOES do is write `dark` and `data-theme` on
             * <html>, which is the signal `theme.css` itself keys off, so
             * watching the attribute is watching the thing that actually
             * happened.
             *
             * It is also strictly better than a handler would be: the theme
             * can change without the button, and this sees that too.
             *
             * The initial theme is deliberately NOT reported. It is applied
             * before first paint by the inline init script, so firing here
             * would file a `theme_change` on every pageview and drown the real
             * ones. `last` starts at whatever is already set, so only a
             * transition counts.
             */
            let last = root.getAttribute('data-theme');

            new MutationObserver(() => {
                const now = root.getAttribute('data-theme');

                if (!now || now === last) return;

                const from = last;
                last = now;

                try {
                    if (window.umami)
                        window.umami.track(name, {
                            from,
                            to: now,
                            path: window.location.pathname
                        });
                } catch (e) {
                    /* Analytics must never break a page. */
                }
            }).observe(root, {
                attributes: true,
                attributeFilter: ['data-theme']
            });
        })()
    </script>
)}
