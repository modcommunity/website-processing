---
import Layout from '../layouts/Layout.astro';

// Astro's static build emits exactly one 404 page, at the site root, which the
// host serves for any unmatched path. It therefore cannot be localized per
// prefix the way the real routes are — the shell (header, rail, footer) still
// renders in the visitor's language, but this copy stays English.
---

<Layout pathName={"/404"} meta={{
    title: "Page Not Found",
    titleMain: "Page Not Found - The Modding Community"
}}>
    <section class="flex flex-col gap-2">
        <h1>404 — Page Not Found</h1>
        <p>
            The page you're looking for doesn't exist or has <span class="special">moved</span>.
        </p>
        <p>
            <a href="/" class="special hover:!text-special-1-light hover:duration-300">
                Head back to the home page
            </a>
        </p>
    </section>
</Layout>
