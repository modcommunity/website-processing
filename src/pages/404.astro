---
import Layout from '../layouts/Layout.astro';

import { LOCALES, DEFAULT_LOCALE, localizeUrl } from '../i18n/config';
import { notFound } from '../i18n/sections/notFound';

/*
 * Astro's static build emits exactly one 404 document, at the site root, which
 * the host serves for any unmatched path in any language. So unlike every real
 * route, this page cannot be localized at build time: at build time there is no
 * locale to read.
 *
 * It is knowable at request time, though — a visitor who lands on /es/typo
 * asked for Spanish just as plainly as one who lands on /es/tos. The document
 * therefore renders English (right for /typo, and what a crawler of /404 sees)
 * and carries the other eight translations with it, swapping them in from the
 * URL's leading segment before paint. The rest of the shell still renders in
 * English here for the same build-time reason; this covers the copy that
 * actually tells a visitor what went wrong.
 *
 * No network, no framework, no flash: the script is inline and synchronous, and
 * the strings are already in the document.
 */
const HOME = Object.fromEntries(
    LOCALES.map((l) => [l, localizeUrl('/', l)])
) as Record<string, string>;

const en = notFound[DEFAULT_LOCALE];
---

<Layout pathName={"/404"} meta={{
    title: en.title,
    titleMain: `${en.title} - The Modding Community`
}}>
    <section class="flex flex-col gap-2">
        <h1 data-nf="heading">{en.heading}</h1>
        <p data-nf="body" set:html={en.body}></p>
        <p>
            <a
                href="/"
                data-nf="home"
                class="special hover:!text-special-1-light hover:duration-300"
            >{en.home}</a>
        </p>
    </section>
</Layout>

<script is:inline define:vars={{ catalog: notFound, home: HOME, fallback: DEFAULT_LOCALE }}>
    // The leading path segment, when it names a locale we actually ship. Any
    // other first segment (a real 404 under the default locale, or junk) leaves
    // the English already in the document untouched.
    const seg = window.location.pathname.split('/')[1];
    const locale = Object.prototype.hasOwnProperty.call(catalog, seg) ? seg : fallback;

    if (locale !== fallback) {
        const strings = catalog[locale];

        for (const el of document.querySelectorAll('[data-nf]')) {
            const value = strings[el.dataset.nf];

            if (typeof value === 'string') {
                // `body` carries an inline <span> from the catalogue, which is
                // authored content and not user input.
                el.innerHTML = value;
            }
        }

        const link = document.querySelector('a[data-nf="home"]');

        if (link && home[locale]) {
            link.setAttribute('href', home[locale]);
        }

        document.documentElement.lang = locale;
        document.title = `${strings.title} - The Modding Community`;
    }
</script>
