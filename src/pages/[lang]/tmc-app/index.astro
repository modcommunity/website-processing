---
import { pageMeta } from '../../../i18n/meta';
import Layout from '../../../layouts/Layout.astro';
import TmcApp from '../../../components/TmcApp.astro';
import { NON_DEFAULT_LOCALES } from '../../../i18n/config';

// One localized copy per non-default locale, so the language picker never 404s
// here. `i18n/sections/tmcApp.ts` carries the body copy in all nine languages;
// `pageMeta.ts` carries the title and description.
export function getStaticPaths() {
    return NON_DEFAULT_LOCALES.map((lang) => ({ params: { lang } }));
}
---

<Layout pathName={Astro.url.pathname} meta={pageMeta("app", Astro.currentLocale)}>
    <h1 class="sr-only">{pageMeta("app", Astro.currentLocale).titleMain}</h1>
    <TmcApp />
</Layout>
