---
import { pageMeta } from '../../../i18n/meta';
import Layout from '../../../layouts/Layout.astro';
import ApiTool from '../../../components/ApiTool.astro';
import { NON_DEFAULT_LOCALES } from '../../../i18n/config';

// Localized route so the language picker never 404s here. The body copy is
// translated in all nine locales via `i18n/sections/apiTool.ts`; the `meta` Title and description: `i18n/sections/pageMeta.ts`.
export function getStaticPaths() {
    return NON_DEFAULT_LOCALES.map((lang) => ({ params: { lang } }));
}
---

<Layout pathName={Astro.url.pathname} meta={pageMeta("cli", Astro.currentLocale)}>
    <h1 class="sr-only">{pageMeta("cli", Astro.currentLocale).titleMain}</h1>
    <ApiTool />
</Layout>
