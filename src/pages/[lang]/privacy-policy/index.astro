---
import Layout from '../../../layouts/Layout.astro';
import PrivacyPolicy from '../../../components/PrivacyPolicy.astro';
import { NON_DEFAULT_LOCALES } from '../../../i18n/config';

export function getStaticPaths() {
    return NON_DEFAULT_LOCALES.map((lang) => ({ params: { lang } }));
}
---

<Layout pathName={Astro.url.pathname} meta={{
    title: "Privacy Policy",
    titleMain: "Privacy Policy - The Modding Community"
}}>
    <h1 class="sr-only">Privacy Policy - The Modding Community</h1>
    <PrivacyPolicy />
</Layout>
