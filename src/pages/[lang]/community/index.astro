---
import Layout from '../../../layouts/Layout.astro';
import Community from '../../../components/Community.astro';
import { NON_DEFAULT_LOCALES } from '../../../i18n/config';

// Localized route so the language picker never 404s here. This page used to
// import <Tos/> and title itself "Terms of Service" — a copy-paste of the
// sibling `[lang]/tos` route that left every localized /xx/community/ serving
// the legal text under a wrong title, and left <Community/> orphaned.
export function getStaticPaths() {
    return NON_DEFAULT_LOCALES.map((lang) => ({ params: { lang } }));
}
---

<Layout pathName={Astro.url.pathname} meta={{
    title: "Community",
    titleMain: "Community - The Modding Community"
}}>
    <h1 class="sr-only">Community - The Modding Community</h1>
    <Community />
</Layout>
